+async function extensionVersionLines(extensionService: IExtensionService): Promise<string[]> {
+	const builtIns = (product.builtInExtensions ?? []).filter(ext => ext.name.toLowerCase().startsWith('wso2.'));
+	if (!builtIns.length) {
+		return [];
+	}
+	await extensionService.whenInstalledExtensionsRegistered();
+	return builtIns.map(builtIn => {
+		const running = extensionService.extensions.find(ext => ExtensionIdentifier.equals(ext.identifier, builtIn.name));
