+/** A signed, downloadable artifact referenced by a manifest entry. */
+export interface IWso2Artifact {
+	readonly url: string;
+	readonly sha256: string;
+	readonly sizeBytes?: number;
+	/**
+	 * Signed provenance for this artifact. `statementUrl` holds a small JSON document binding the
+	 * artifact's IDENTITY to its bytes — `{ id, version, sha256, sizeBytes, requires }` — and
+	 * `sigUrl` is the detached cosign signature over that document, verified against the pinned
+	 * `wso2UpdatePublicKey`.
+	 *
+	 * Signing the statement rather than the bytes is what makes the surrounding manifest
+	 * untrustworthy-by-design: a signature over bytes alone proves only "WSO2 produced this file",
+	 * so a manifest could offer an older signed artifact under a newer version label and the client
+	 * would install it, believe it was current, and then refuse the real fix (its version check only
+	 * moves forward). Binding id+version+digest into the signed document closes that, and carries
+	 * `requires` inside the signature so compatibility constraints cannot be relaxed either.
+	 *
+	 * Present only for artifacts mirrored to the WSO2 update bucket, which is where CI can sign
+	 * them; a third-party source URL has no statement of ours.
+	 */
+	readonly signature?: {
+		readonly statementUrl: string;
+		readonly sigUrl: string;
+	};
+}
