+import * as fs from 'fs';
+import * as path from '../../../base/common/path.js';
+
+/**
+ * Local components manifest bookkeeping. This module intentionally depends only on
+ * `node:fs` / `node:path` (no DI, no Electron) so it can be used both by the
+ * main-process update service and by the early `main.ts` bootstrap, which activates
+ * pending runtime updates before any window or extension host is created.
+ */
+
+export interface ILocalComponentVersion {
+	readonly version: string;
+	/** Path to the component root, relative to the data-folder home or absolute. */
+	readonly path?: string;
+	/** For extensions installed as user shadow copies. */
+	readonly via?: 'user-extension';
+	readonly installedAt?: string;
+	readonly healthy?: boolean;
+	/** Consecutive boots this override has been active without being confirmed healthy (auto-fallback). */
+	readonly bootCount?: number;
+	/**
+	 * The requirements the server attached to this version when it was offered, recorded at staging
+	 * so activation can re-check them at boot. They were satisfied when the component was staged,
+	 * but the app that boots next is not necessarily the app that staged it: an app update may have
+	 * landed in between, or failed to. Absent on versions staged before requirements were recorded,
+	 * which activate unconditionally exactly as they always did.
+	 */
+	readonly requires?: { readonly [id: string]: string };
+}
+
+export interface ILocalComponentEntry {
+	bundledVersion?: string;
+	active?: ILocalComponentVersion | null;
+	previous?: ILocalComponentVersion | null;
+	pending?: ILocalComponentVersion | null;
+	/**
+	 * An extension downloaded for an app update that is not running yet, installed by the main
+	 * process when that app boots and before any window opens, so the extension host starts on it.
+	 * Kept apart from `pending`, which is runtime activation's: `path` is a VSIX, not a runtime root.
+	 */
+	deferredExtension?: ILocalComponentVersion | null;
+	/**
+	 * Versions auto-reverted after they kept the app from booting. Recorded so the same version is
+	 * not offered, downloaded and activated again on the very next check — which, since the revert
+	 * also drops it out of the garbage collector's keep-set, would mean re-downloading hundreds of
+	 * megabytes to crash-loop with it a second time.
+	 *
+	 * Only the exact version is refused; a later one is still offered, because a fix ships as a new
+	 * version and blocking the whole component would strand the user on the bundled copy forever.
+	 */
+	failed?: IFailedComponentVersion[];
+}
+
+export interface IFailedComponentVersion {
+	version: string;
+	/** ISO timestamp of the revert, for support diagnosis. */
+	at: string;
+}
+
+export interface ILocalComponentsManifest {
+	schemaVersion: number;
+	bundledAppVersion?: string;
+	channel?: string;
+	lastCheck?: string;
+	lastManifestSequence?: number;
+	/** Locally generated, never transmitted; used only for rollout bucketing. */
+	deviceId?: string;
+	components: { [id: string]: ILocalComponentEntry };
+}
+
+export const LOCAL_MANIFEST_SCHEMA_VERSION = 1;
+
+export function getComponentsHome(homeDir: string, dataFolderName: string): string {
+	return path.join(homeDir, dataFolderName, 'components');
+}
+
+export function getComponentsManifestPath(componentsHome: string): string {
+	return path.join(componentsHome, 'manifest.json');
+}
+
+export function getStagingHome(homeDir: string, dataFolderName: string): string {
+	return path.join(homeDir, dataFolderName, 'updates', 'staging');
+}
+
+export function getDownloadsHome(homeDir: string, dataFolderName: string): string {
+	return path.join(homeDir, dataFolderName, 'updates', 'downloads');
+}
+
+/** Reads the local manifest, returning `undefined` if it is missing or unreadable. */
+export function readLocalManifest(componentsHome: string): ILocalComponentsManifest | undefined {
+	try {
+		const manifestPath = getComponentsManifestPath(componentsHome);
+		if (!fs.existsSync(manifestPath)) {
+			return undefined;
+		}
+		const parsed = JSON.parse(fs.readFileSync(manifestPath, 'utf8'));
+		if (!parsed || typeof parsed !== 'object' || typeof parsed.components !== 'object') {
+			return undefined;
+		}
+		return parsed as ILocalComponentsManifest;
+	} catch {
+		return undefined;
+	}
+}
+
+/** Atomically writes the local manifest (write temp file + rename). */
+export function writeLocalManifest(componentsHome: string, manifest: ILocalComponentsManifest): void {
+	fs.mkdirSync(componentsHome, { recursive: true });
+	const manifestPath = getComponentsManifestPath(componentsHome);
+	const tmpPath = `${manifestPath}.tmp`;
+	fs.writeFileSync(tmpPath, JSON.stringify(manifest, null, 2), 'utf8');
+	fs.renameSync(tmpPath, manifestPath);
+}
+
+/**
+ * Resolves the active override root (absolute path) for each runtime component that
+ * has one installed. Extension shadow copies (`via: 'user-extension'`) are excluded
+ * because they are resolved by the extension scanner, not via `runtimeEnv`.
+ */
+export function getActiveOverrides(manifest: ILocalComponentsManifest | undefined, dataFolderHome: string): Record<string, string> {
+	const overrides: Record<string, string> = {};
+	if (!manifest) {
+		return overrides;
+	}
+	for (const [id, entry] of Object.entries(manifest.components)) {
+		const active = entry?.active;
+		if (active && typeof active.path === 'string' && active.path.length > 0) {
+			overrides[id] = path.normalize(path.isAbsolute(active.path) ? active.path : path.join(dataFolderHome, active.path));
+		}
+	}
+	return overrides;
+}
+
+/**
+ * Activates any runtime components staged as `pending`: if the staged directory
+ * exists, the previous active version is retained (for revert) and the pending
+ * version becomes active; otherwise the invalid pending entry is discarded. This is
+ * safe to call from the bootstrap because it only rewrites the manifest — the staged
+ * directories were already put in place at download time.
+ *
+ * Returns the resolved active overrides after activation.
+ */
+export function activatePendingRuntimeComponents(dataFolderHome: string, runningAppVersion: string | undefined, log?: (message: string) => void): Record<string, string> {
+	// `dataFolderHome` is `<home>/<dataFolderName>`; components live under it.
+	const componentsHome = path.join(dataFolderHome, 'components');
+	const manifest = readLocalManifest(componentsHome);
+	if (!manifest) {
+		return {};
+	}
+
+	const stagedPath = (pending: ILocalComponentVersion) => typeof pending.path === 'string' && pending.path.length > 0
+		? (path.isAbsolute(pending.path) ? pending.path : path.join(dataFolderHome, pending.path))
+		: undefined;
+	// The same existence test that discards below, so a dependent is judged against what will run.
+	const held = heldBackPendingComponents(manifest, runningAppVersion, pending => {
+		const target = stagedPath(pending);
+		return !!target && fs.existsSync(target);
+	});
+	let changed = false;
+	for (const [id, entry] of Object.entries(manifest.components)) {
+		const pending = entry?.pending;
+		if (!pending) {
+			continue;
+		}
+		const targetPath = stagedPath(pending);
+		const reason = held.get(id);
+		if (reason && targetPath && fs.existsSync(targetPath)) {
+			// Left exactly as staged: it activates on the first boot of an app that satisfies it.
+			log?.(`Holding component ${id}@${pending.version} until a compatible app is running (${reason})`);
+			continue;
+		}
+		if (targetPath && fs.existsSync(targetPath)) {
+			if (entry.active && entry.active.version !== pending.version) {
+				entry.previous = entry.active;
+			}
+			entry.active = { ...pending, healthy: false };
+			entry.pending = null;
+			changed = true;
+			log?.(`Activated component ${id}@${pending.version}`);
+		} else {
+			entry.pending = null;
+			changed = true;
+			log?.(`Discarded invalid pending component ${id}@${pending.version} (missing ${targetPath ?? 'path'})`);
+		}
+	}
+
+	// Heal a missing/corrupt active override: fall back to the previous version if its dir still
+	// exists, else to the bundled/seeded baseline (active=null → the `${COMPONENT}` fallback
+	// resolves it). Covers a user deleting the active version dir as a manual recovery step, or a
+	// partial write — post editor-only update the app cannot re-seed, so this keeps a manual delete
+	// from hard-breaking the editor. Extension shadows are excluded (the extension scanner heals
+	// those via semver dedup).
+	for (const [id, entry] of Object.entries(manifest.components)) {
+		const active = entry?.active;
+		if (!active || active.via === 'user-extension') {
+			continue;
+		}
+		const activePath = typeof active.path === 'string' && active.path.length > 0
+			? (path.isAbsolute(active.path) ? active.path : path.join(dataFolderHome, active.path))
+			: undefined;
+		if (!activePath || fs.existsSync(activePath)) {
+			continue; // no versioned dir to check, or it is present — nothing to heal
+		}
+		const prev = entry.previous;
+		const prevPath = prev && typeof prev.path === 'string' && prev.path.length > 0
+			? (path.isAbsolute(prev.path) ? prev.path : path.join(dataFolderHome, prev.path))
+			: undefined;
+		entry.active = (prevPath && fs.existsSync(prevPath)) ? { ...prev!, healthy: true } : null;
+		entry.previous = null;
+		changed = true;
+		log?.(`Healed ${id}: active ${active.version} dir missing → ${entry.active ? 'previous ' + prev!.version : 'bundled'}`);
+	}
+
+	if (changed) {
+		try {
+			writeLocalManifest(componentsHome, manifest);
+		} catch {
+			// Non-fatal: fall back to whatever is currently on disk.
+		}
+	}
+
+	return getActiveOverrides(manifest, dataFolderHome);
+}
+
+/**
+ * Crash-loop safety net (auto-fallback, §D5): a runtime override is activated as `healthy: false`
+ * and confirmed healthy by the update service once the app boots successfully. If the app never
+ * reaches that point, the override stays unhealthy across boots. Note the net's limit: the main
+ * process never loads these runtimes itself, so it catches an override that breaks BOOT (bad env
+ * resolution, unreadable directory) but not one that only breaks the language server or extension
+ * host after startup — those failures surface in the extension, not here. This is called at bootstrap (before the runtime env is resolved) and
+ * increments a per-override boot counter; once it exceeds `maxUnhealthyBoots` the override is
+ * automatically rolled back to the previous version (or the bundled baseline when no previous
+ * dir remains), so the app can start again. Extension shadow copies are excluded (the extension
+ * host handles those). Returns the ids that were rolled back.
+ */
+export function enforceRuntimeHealthFallback(dataFolderHome: string, maxUnhealthyBoots: number, log?: (message: string) => void): string[] {
+	const componentsHome = path.join(dataFolderHome, 'components');
+	const manifest = readLocalManifest(componentsHome);
+	if (!manifest) {
+		return [];
+	}
+	const reverted: string[] = [];
+	let changed = false;
+	for (const [id, entry] of Object.entries(manifest.components)) {
+		const active = entry?.active;
+		if (!active || active.healthy !== false || active.via === 'user-extension') {
+			continue;
+		}
+		const attempts = (active.bootCount ?? 0) + 1;
+		if (attempts > maxUnhealthyBoots) {
+			const prev = entry.previous;
+			const prevPath = prev && typeof prev.path === 'string' && prev.path.length > 0
+				? (path.isAbsolute(prev.path) ? prev.path : path.join(dataFolderHome, prev.path))
+				: undefined;
+			entry.active = (prevPath && fs.existsSync(prevPath)) ? { ...prev!, healthy: true } : null;
+			// Remember what failed. Without this the next check offers the same version straight
+			// back, re-downloads it, and the machine crash-loops again — and because the revert
+			// leaves `active` null with `previous` often unset, the garbage collector has already
+			// deleted the directory, so it is a full re-download every time.
+			if (active.version) {
+				const failed = entry.failed ?? [];
+				if (!failed.some(f => f.version === active.version)) {
+					failed.push({ version: active.version, at: new Date().toISOString() });
+				}
+				entry.failed = failed;
+			}
+			reverted.push(id);
+			log?.(`Auto-reverted ${id}@${active.version} after ${attempts - 1} unhealthy boot(s); it will not be offered again`);
+		} else {
+			entry.active = { ...active, bootCount: attempts };
+			log?.(`Component ${id}@${active.version} unhealthy boot attempt ${attempts}`);
+		}
+		changed = true;
+	}
+	if (changed) {
+		try {
+			writeLocalManifest(componentsHome, manifest);
+		} catch {
+			// Non-fatal: fall back to whatever is currently on disk.
+		}
+	}
+	return reverted;
+}
+
+/**
+ * Drops component overrides that a freshly installed full app has caught up with or
+ * superseded (bundled version >= active override version). Extension shadow copies
+ * self-heal via the extension scanner's semver dedup and are left untouched here.
+ */
+export function reconcileBundledVersions(
+	componentsHome: string,
+	bundledComponents: { readonly [id: string]: string } | undefined,
+	log?: (message: string) => void
+): void {
+	if (!bundledComponents) {
+		return;
+	}
+	const manifest = readLocalManifest(componentsHome);
+	if (!manifest) {
+		return;
+	}
+	let changed = false;
+	for (const [id, bundledVersion] of Object.entries(bundledComponents)) {
+		const entry = manifest.components[id];
+		if (!entry) {
+			continue;
+		}
+		entry.bundledVersion = bundledVersion;
+		const active = entry.active;
+		// The bundled version supersedes an override only if it is really there. An editor-only
+		// update advances product.json without carrying the components, so taking the declared
+		// version at its word here retires a working override in favour of a version that was
+		// never installed -- the same mistake the inventory used to make.
+		const bundledPresent = fs.existsSync(path.toNamespacedPath(path.join(componentsHome, id, bundledVersion)));
+		if (bundledPresent && active && active.via !== 'user-extension' && active.version && compareVersions(bundledVersion, active.version) >= 0) {
+			entry.previous = active;
+			entry.active = null;
+			changed = true;
+			log?.(`Dropped override ${id}@${active.version} superseded by bundled ${bundledVersion}`);
+		}
+	}
+	if (changed) {
+		try {
+			writeLocalManifest(componentsHome, manifest);
+		} catch {
+			// Non-fatal.
+		}
+	}
+}
+
+/**
+ * Normalizes executable permissions in an extracted runtime tree. Zip archives may
+ * carry missing or malformed unix permission bits (e.g. an entry with no owner-execute
+ * bit), which leaves launchers like `bin/bal` or the bundled JRE's `java` unrunnable
+ * ("permission denied"). Any file inside a `bin/` directory, or any file that already
+ * has some execute bit, is set to 0755 (preserving the non-permission mode bits).
+ * Symlinks are skipped, and on Windows the execute bits are meaningless (harmless no-op).
+ */
+export function ensureExecutablePermissions(root: string): void {
+	// Execute bits are meaningless on Windows; skip the (deep, potentially long-path)
+	// walk entirely there.
+	if (process.platform === 'win32') {
+		return;
+	}
+	const walk = (dir: string): void => {
+		let entries: fs.Dirent[];
+		try {
+			entries = fs.readdirSync(dir, { withFileTypes: true });
+		} catch {
+			return;
+		}
+		const inBin = path.basename(dir) === 'bin';
+		for (const entry of entries) {
+			const full = path.join(dir, entry.name);
+			if (entry.isDirectory()) {
+				walk(full);
+			} else if (entry.isFile()) {
+				try {
+					const mode = fs.statSync(full).mode;
+					if (inBin || (mode & 0o111)) {
+						fs.chmodSync(full, (mode & ~0o777) | 0o755);
+					}
+				} catch {
+					// ignore individual files we can't stat/chmod
+				}
+			}
+		}
+	};
+	walk(root);
+}
+
+/**
+ * Where a replaced tree is parked while its contents are moved back over the fresh copy. It sits
+ * at the components-home ROOT on purpose: the stale sweep only walks `components/<id>` for
+ * `*.seeding*`/`*.repair-*` names, and the garbage collector only enumerates `components/<id>`
+ * for known component ids, so neither can reach it. On the success path nothing is left here.
+ */
+const SALVAGE_DIR = '.salvaged';
+
+/**
+ * Restores a replaced component tree over the freshly seeded one.
+ *
+ * A component writes into its own directory, and at BUNDLED paths: ICP ships
+ * `bin/database/icp_db.mv.db`, `credentials_db.mv.db` and `www/config.json`, then writes to those
+ * very files (the deb/rpm postinst chmods them for exactly that reason). So "keep what the bundle
+ * does not ship" would discard the database it is meant to protect.
+ *
+ * What the replace path actually repairs is ABSENCE: `seedContainsSource` rejects a tree only for
+ * a missing entry, or a zero-length file where the bundle's is not empty. Every other path present
+ * in the old tree was intact, and may hold the user's data. So the fresh copy supplies what was
+ * missing and the old tree is moved back over everything else.
+ *
+ * Moves, never copies: same filesystem, so each entry is a rename. Nothing is read or rewritten,
+ * which matters because this runs synchronously before any window opens and ICP's `logs/` has no
+ * size limit.
+ */
+function overlayPreservedTree(srcDir: string, salvage: string, target: string, log?: (message: string) => void): { restored: number; failed: number } {
+	let restored = 0;
+	let failed = 0;
+	const walk = (rel: string): void => {
+		const here = rel ? path.join(salvage, rel) : salvage;
+		let entries: fs.Dirent[];
+		try {
+			entries = fs.readdirSync(path.toNamespacedPath(here), { withFileTypes: true });
+		} catch (err) {
+			failed++;
+			log?.(`WARN: cannot read ${rel || '.'} in the replaced tree: ${err}`);
+			return;
+		}
+		for (const entry of entries) {
+			const childRel = rel ? path.join(rel, entry.name) : entry.name;
+			const from = path.join(salvage, childRel);
+			const to = path.join(target, childRel);
+			const bundled = path.join(srcDir, childRel);
+			// The stale marker from the replaced tree must never overwrite the one just stamped.
+			if (!rel && entry.name === SEED_COMPLETE_MARKER) {
+				continue;
+			}
+			let bundledStat: fs.Stats | undefined;
+			try {
+				bundledStat = fs.statSync(path.toNamespacedPath(bundled));
+			} catch { /* not shipped by the bundle: purely the component's own */ }
+			if (entry.isDirectory()) {
+				if (bundledStat && !bundledStat.isDirectory()) {
+					continue; // bundle turned this path into a file; keep the fresh copy
+				}
+				try {
+					fs.mkdirSync(path.toNamespacedPath(to), { recursive: true });
+				} catch (err) {
+					failed++;
+					log?.(`WARN: cannot create ${childRel} in the new tree: ${err}`);
+					continue;
+				}
+				walk(childRel);
+				continue;
+			}
+			if (bundledStat?.isFile()) {
+				// The damage this path repairs: an entry the old tree has but empty, where the
+				// bundle's is not. Keep the fresh copy rather than restoring the truncated one.
+				let oldSize = -1;
+				try {
+					oldSize = fs.statSync(path.toNamespacedPath(from)).size;
+				} catch { /* unreadable; fall through and let the move report it */ }
+				if (oldSize === 0 && bundledStat.size > 0) {
+					continue;
+				}
+			}
+			try {
+				fs.rmSync(path.toNamespacedPath(to), { recursive: true, force: true }); // rename onto an existing path fails on Windows
+				fs.renameSync(path.toNamespacedPath(from), path.toNamespacedPath(to));
+				restored++;
+			} catch (err) {
+				failed++;
+				log?.(`WARN: could not restore ${childRel}: ${err}`);
+			}
+		}
+	};
+	walk('');
+	return { restored, failed };
+}
+
+/**
+ * Marker file written (fsync'd) into a seeded version directory as the last step before it
+ * is promoted. Its presence is what distinguishes a COMPLETE seed from a partial tree
+ * committed by a racing second instance or a hard power-off, so the idempotence check must
+ * test for it rather than for the directory alone.
+ */
+export const SEED_COMPLETE_MARKER = '.wso2-seeded';
+
+/**
+ * Matches `<version>.seeding[-<pid>]` staging directories of in-flight or crashed seed
+ * attempts, and `<version>.repair-<pid>` partial trees claimed for repair.
+ */
+const SEEDING_DIR_RE = /\.(?:seeding|repair)(?:-(?<pid>\d+))?$/;
+
+/** A staging directory older than this cannot be a live copy (a first-run seed takes minutes). */
+const MAX_SEEDING_AGE_MS = 24 * 60 * 60 * 1000;
+
+/**
+ * Whether a directory under `components/<id>/` is a seeding staging (or repair-claim)
+ * directory that a LIVE process still owns. The garbage collector and the stale sweep must
+ * skip these: deleting one mid-copy re-opens the partial-seed race the per-pid staging
+ * protocol closes. A pid-less name (the pre-pid staging format) or a dead owner marks the
+ * directory as stale and collectable — and so does age: pids are recycled (quickly, on
+ * Windows), so a leftover from before a reboot can carry the pid of an unrelated live
+ * process and would otherwise be skipped forever. The staging root's mtime is set when the
+ * copy starts, so a >1-day-old "live" dir is treated as stale; a copy that genuinely spans
+ * that (hibernation mid-first-boot) loses its rename and retries on the next launch.
+ */
+export function isActiveSeedingDir(parentDir: string, name: string): boolean {
+	const pid = SEEDING_DIR_RE.exec(name)?.groups?.pid;
+	if (!pid || !isPidAlive(parseInt(pid, 10))) {
+		return false;
+	}
+	try {
+		return Date.now() - fs.statSync(path.toNamespacedPath(path.join(parentDir, name))).mtimeMs < MAX_SEEDING_AGE_MS;
+	} catch {
+		return false;
+	}
+}
+
+function isPidAlive(pid: number): boolean {
+	try {
+		process.kill(pid, 0);
+		return true;
+	} catch (err) {
+		// EPERM means the process exists but belongs to someone else — still alive.
+		return (err as NodeJS.ErrnoException).code === 'EPERM';
+	}
+}
+
+/** Removes leftover `*.seeding*` / `*.repair-*` directories whose owning process is gone. */
+function sweepStaleSeedingDirs(componentDir: string, log?: (message: string) => void): void {
+	let entries: fs.Dirent[];
+	try {
+		entries = fs.readdirSync(componentDir, { withFileTypes: true });
+	} catch {
+		return; // component dir doesn't exist yet
+	}
+	for (const entry of entries) {
+		if (!entry.isDirectory() || !SEEDING_DIR_RE.test(entry.name) || isActiveSeedingDir(componentDir, entry.name)) {
+			continue;
+		}
+		try {
+			fs.rmSync(path.toNamespacedPath(path.join(componentDir, entry.name)), { recursive: true, force: true });
+			log?.(`Swept stale seeding directory ${entry.name}`);
+		} catch { /* best effort; the seeder never reuses another pid's staging path */ }
+	}
+}
+
+/**
+ * Cheap structural check that `target` contains everything `srcDir` does: every source
+ * entry exists in the target with the same kind, and no file with content in the source is
+ * empty in the target. Extra target entries, sizes and file contents are deliberately NOT
+ * compared — component homes gain and change files at runtime (ICP writes its logs and
+ * database into its home, the Ballerina home gains a `dependencies` link), so equality
+ * checks would reject healthy seeds and delete live data.
+ */
+function seedContainsSource(srcDir: string, target: string): boolean {
+	let entries: fs.Dirent[];
+	try {
+		entries = fs.readdirSync(path.toNamespacedPath(srcDir), { withFileTypes: true });
+	} catch {
+		return false;
+	}
+	for (const entry of entries) {
+		const srcPath = path.join(srcDir, entry.name);
+		const dstPath = path.join(target, entry.name);
+		try {
+			if (entry.isSymbolicLink()) {
+				fs.lstatSync(path.toNamespacedPath(dstPath)); // must exist in some form
+			} else if (entry.isDirectory()) {
+				if (!fs.statSync(path.toNamespacedPath(dstPath)).isDirectory() || !seedContainsSource(srcPath, dstPath)) {
+					return false;
+				}
+			} else if (entry.isFile()) {
+				const dstStat = fs.statSync(path.toNamespacedPath(dstPath));
+				if (!dstStat.isFile() || (dstStat.size === 0 && fs.statSync(path.toNamespacedPath(srcPath)).size > 0)) {
+					return false;
+				}
+			}
+		} catch {
+			return false; // missing or unreadable counterpart
+		}
+	}
+	return true;
+}
+
+/**
+ * Writes the completion marker into `dir`, fsync'd so the marker cannot itself be the torn
+ * file. The payload is NOT fsync'd — per-file fsync of a multi-hundred-MB tree stalls the
+ * first boot — so a power cut in the write-back seconds after the promoting rename can in
+ * principle persist the rename and marker while losing payload data. Accepted residual
+ * risk: closing it by verifying payload stats against the marker on later boots would
+ * false-positive on the runtime mutations described on `seedContainsSource` and delete
+ * live data, which is worse than the narrow window it would guard.
+ */
+function stampSeedMarker(dir: string, version: string): void {
+	const fd = fs.openSync(path.toNamespacedPath(path.join(dir, SEED_COMPLETE_MARKER)), 'w');
+	try {
+		fs.writeSync(fd, version);
+		fs.fsyncSync(fd);
+	} finally {
+		fs.closeSync(fd);
+	}
+}
+
+/**
+ * Copies bundled runtime component directories out of the app install tree into the
+ * per-user components home on first run, so `${COMPONENT:<id>}` can resolve to a location
+ * no core-app updater will delete (see design doc §D8). This lets the core-app update
+ * ship editor-only: the seeded copy survives a `.app`/MSI/deb replacement of the install.
+ *
+ * `seeds` maps component id -> { srcDir (absolute, in the install tree), version }. A
+ * component whose seeded versioned directory already exists WITH its completion marker is
+ * skipped (idempotent), and a component whose source directory is missing is skipped.
+ *
+ * Crash/concurrency protocol: seeding runs BEFORE the single-instance lock, so two
+ * instances launched together (installer "launch now" + a shortcut double-click on the slow
+ * first boot) both reach here. Each copies into its own `<version>.seeding-<pid>` staging
+ * directory — never a shared one, which a second instance's cleanup used to gut mid-copy,
+ * letting the first instance rename a tree with holes into place, permanently (the
+ * existence check then trusted it forever; only a manual delete recovered). The marker is
+ * written last, so a committed directory without it is recognized as suspect on the next
+ * launch and either adopted in place (when it still contains the bundled payload) or
+ * replaced copy-first (unless the bundled source is gone after an editor-only update, when
+ * a partial tree is still the best available). The rename loser fails on "target exists"
+ * and just cleans up its own staging.
+ */
+export function seedBundledComponents(
+	componentsHome: string,
+	seeds: { [id: string]: { srcDir: string; version: string } },
+	log?: (message: string) => void
+): void {
+	for (const [id, seed] of Object.entries(seeds)) {
+		const { srcDir, version } = seed;
+		if (!version) {
+			continue;
+		}
+		const componentDir = path.join(componentsHome, id);
+		const target = path.join(componentDir, version);
+		const marker = path.join(target, SEED_COMPLETE_MARKER);
+		sweepStaleSeedingDirs(componentDir, log);
+		const srcExists = fs.existsSync(srcDir);
+		if (fs.existsSync(target)) {
+			if (fs.existsSync(marker)) {
+				continue; // complete seed
+			}
+			if (!srcExists) {
+				// Editor-only install: nothing to re-seed from, and a pre-marker or partial
+				// tree beats no runtime at all. Do not delete what cannot be rebuilt.
+				log?.(`Seed ${id}@${version} lacks its completion marker but no bundled source remains; leaving it in place`);
+				continue;
+			}
+			// Adopt a marker-less tree in place when it already contains everything the bundle
+			// does: every install seeded before the marker existed is marker-less, and making
+			// them all delete + re-copy hundreds of MB on the first launch after an update —
+			// synchronously, before any window — is a cost healthy installs must not pay. This
+			// also keeps a verified updater download whose version equals the bundled one.
+			if (seedContainsSource(srcDir, target)) {
+				try {
+					stampSeedMarker(target, version);
+					log?.(`Adopted existing seed ${id}@${version} (contains the bundled payload)`);
+				} catch (err) {
+					// A permanently unstampable seed (read-only components home) is a real failure
+					// state: the containment walk re-runs synchronously on EVERY launch until the
+					// stamp succeeds, not just once.
+					log?.(`ERROR: failed to stamp adopted seed ${id}@${version}; the containment walk will repeat on every launch until this succeeds: ${err}`);
+				}
+				continue;
+			}
+			log?.(`Seed ${id}@${version} is missing bundled payload; re-seeding`);
+		}
+		if (!srcExists) {
+			continue;
+		}
+		const staging = `${target}.seeding-${process.pid}`;
+		try {
+			// Windows MAX_PATH (260): the bundled Ballerina/JRE trees have deeply nested
+			// files whose destination paths exceed 260 chars. Node's fs.cpSync/rmSync throw
+			// (or truncate) on those without the \\?\ extended-length prefix, leaving the
+			// component only partially seeded (or not at all). The Windows Installer copies
+			// them fine because it uses long-path-aware native APIs; match that here.
+			fs.rmSync(path.toNamespacedPath(staging), { recursive: true, force: true });
+			fs.mkdirSync(path.dirname(target), { recursive: true });
+			fs.cpSync(path.toNamespacedPath(srcDir), path.toNamespacedPath(staging), { recursive: true });
+			ensureExecutablePermissions(staging);
+			stampSeedMarker(staging, version);
+			// Copy first, swap after: an incomplete target survives until a full replacement is
+			// ready, so a copy failure (disk full, an antivirus holding a handle) can never turn
+			// a partially working install into one with no runtime at all. The swap claims the
+			// old tree with an atomic rename (one winner per tree) and restores it if putting
+			// the new tree in place fails. A crashed swap leaves `<target>.repair-<pid>`, swept
+			// as stale above. The marker re-check below skips the swap when a faster instance
+			// completed the seed while this one was copying; a completion landing in the
+			// remaining window is replaced with identical content, which is harmless.
+			if (fs.existsSync(marker)) {
+				fs.rmSync(path.toNamespacedPath(staging), { recursive: true, force: true });
+				log?.(`Another instance completed seeding ${id}@${version} while this one was copying; discarding own copy`);
+				continue;
+			}
+			let claimed: string | undefined;
+			if (fs.existsSync(target)) {
+				claimed = `${target}.repair-${process.pid}`;
+				try {
+					fs.renameSync(path.toNamespacedPath(target), path.toNamespacedPath(claimed));
+					// rename() keeps the renamed tree's own mtime, which on a real install is
+					// weeks old — without a refresh, the age guard in isActiveSeedingDir reads
+					// the claim as stale the moment it exists, and a concurrent sweep/GC could
+					// delete it in the claim-to-swap window, leaving the restore below with
+					// nothing to rename back.
+					const now = new Date();
+					fs.utimesSync(path.toNamespacedPath(claimed), now, now);
+				} catch {
+					claimed = undefined; // a racing instance owns or replaced it; our rename below decides
+				}
+			}
+			try {
+				fs.renameSync(path.toNamespacedPath(staging), path.toNamespacedPath(target));
+			} catch (err) {
+				if (claimed) {
+					try {
+						fs.renameSync(path.toNamespacedPath(claimed), path.toNamespacedPath(target));
+					} catch { /* target was replaced by a racing instance; the claimed dir is swept as stale */ }
+				}
+				throw err;
+			}
+			if (claimed) {
+				// Move the replaced tree out of the way FIRST: a rename is atomic and costs no
+				// disk, so the old tree cannot be lost by anything that follows. Copying it
+				// instead — right after writing hundreds of MB of bundle — could fail on a full
+				// disk and then fall through to the delete, which is the bug this guards.
+				let salvage: string | undefined = path.join(componentsHome, SALVAGE_DIR, id, `${version}-${Date.now()}`);
+				try {
+					fs.mkdirSync(path.dirname(path.toNamespacedPath(salvage)), { recursive: true });
+					fs.renameSync(path.toNamespacedPath(claimed), path.toNamespacedPath(salvage));
+				} catch (err) {
+					// Could not park it: leave the claim where it is rather than delete it. A
+					// `.repair-<pid>` directory is swept once its owner is gone, so this trades a
+					// later automatic cleanup for not destroying data now.
+					salvage = undefined;
+					log?.(`WARN: could not set aside the replaced ${id}@${version} tree; leaving ${claimed} in place: ${err}`);
+				}
+				if (salvage) {
+					const { restored, failed } = overlayPreservedTree(srcDir, salvage, target, log);
+					if (failed === 0) {
+						// Everything worth keeping is now in the live tree; the remainder is the
+						// damage the fresh copy replaced. Nothing is retained, so nothing accumulates.
+						try {
+							fs.rmSync(path.toNamespacedPath(salvage), { recursive: true, force: true });
+							// And the now-empty parents, so a repaired install leaves no trace at
+							// all. rmdir throws ENOTEMPTY when another component still has a
+							// salvage of its own, which is exactly the right stopping condition.
+							fs.rmdirSync(path.toNamespacedPath(path.dirname(salvage)));
+							fs.rmdirSync(path.toNamespacedPath(path.join(componentsHome, SALVAGE_DIR)));
+						} catch { /* an empty leftover under .salvaged is inert */ }
+						if (restored > 0) {
+							log?.(`Restored ${restored} item(s) from the replaced ${id}@${version} tree over the fresh copy`);
+						}
+					} else {
+						log?.(`ERROR: ${failed} item(s) from the replaced ${id}@${version} tree could not be restored; they are kept at ${salvage}`);
+					}
+				}
+			}
+			log?.(`Seeded ${id}@${version} from ${srcDir}`);
+		} catch (err) {
+			// Best-effort cleanup: a failing rm here must not escape the catch, or one broken
+			// component would stop the remaining components from being seeded.
+			try {
+				fs.rmSync(path.toNamespacedPath(staging), { recursive: true, force: true });
+			} catch { /* best effort */ }
+			if (fs.existsSync(marker)) {
+				log?.(`Another instance completed seeding ${id}@${version} first (own attempt failed with: ${err})`);
+			} else {
+				log?.(`Failed to seed ${id}@${version}: ${err}`);
+			}
+		}
+	}
+}
+
+/** A directory name that looks like a version, so `backup` or `old` never ranks as one. */
+const VERSION_DIR_RE = /^\d+(\.\d+)*(-[0-9A-Za-z.]+)?$/;
+
+/**
+ * Newest version directory actually present for a component, or undefined when none is.
+ *
+ * Every other reader looks the seeded baseline up by name — the version the running app
+ * DECLARES it bundles. That holds for an app installed from the full installer, and breaks the
+ * moment an editor-only update ships a product.json naming runtimes it does not carry: the
+ * declared version is not on disk, an older one is, and a lookup by name finds neither. Asking
+ * what is actually there is the only question with a reliable answer.
+ *
+ * Newest wins outright; the seed-completion marker is NOT preferred. Directories installed by
+ * the updater never carry one, so preferring marked would hand back an older seeded runtime in
+ * favour of a newer working one — and on a real machine none of the three components carried a
+ * marker at all. Staging directories and empty remnants are skipped, so a copy still in flight
+ * can never be mistaken for a usable tree.
+ */
+export function newestSeededVersion(componentsHome: string, id: string, exclude?: Iterable<string>): string | undefined {
+	const excluded = exclude ? new Set(exclude) : undefined;
+	const dir = path.join(componentsHome, id);
+	let entries: fs.Dirent[];
+	try {
+		entries = fs.readdirSync(path.toNamespacedPath(dir), { withFileTypes: true });
+	} catch {
+		return undefined; // no directory for this component at all
+	}
+	let newest: string | undefined;
+	for (const entry of entries) {
+		if (!entry.isDirectory() || !VERSION_DIR_RE.test(entry.name) || SEEDING_DIR_RE.test(entry.name)) {
+			continue;
+		}
+		if (excluded?.has(entry.name)) {
+			continue; // auto-reverted, or staged but not yet activated -- see ineligibleBaselineVersions
+		}
+		try {
+			if (fs.readdirSync(path.toNamespacedPath(path.join(dir, entry.name))).length === 0) {
+				continue; // an empty directory is a remnant, never a runtime
+			}
+		} catch {
+			continue;
+		}
+		if (!newest || compareVersions(entry.name, newest) > 0) {
+			newest = entry.name;
+		}
+	}
+	return newest;
+}
+
+/**
+ * The version of a component that is actually installed: the declared bundled version when its
+ * directory is present, otherwise the newest one that is, and undefined when none is.
+ *
+ * Deliberately never falls back to the declared version. Resolution, the inventory sent to the
+ * server, dependency checks and the GC keep-set all used to assume "declared" meant "installed",
+ * which is how an editor-only update left the app resolving a deleted path while telling the
+ * server it already had the runtime it was missing. One answer, in one place, so those four
+ * cannot drift apart again.
+ */
+export function installedComponentVersion(componentsHome: string, id: string, declaredVersion: string | undefined, exclude?: Iterable<string>): string | undefined {
+	const excluded = exclude ? new Set(exclude) : undefined;
+	if (declaredVersion && !excluded?.has(declaredVersion)
+		&& fs.existsSync(path.toNamespacedPath(path.join(componentsHome, id, declaredVersion)))) {
+		return declaredVersion;
+	}
+	return newestSeededVersion(componentsHome, id, excluded);
+}
+
+/**
+ * Versions present on disk that must never be adopted as a baseline.
+ *
+ * `failed` holds versions auto-reverted after they kept the app from booting. Before the on-disk
+ * fallback existed they were simply garbage-collected, so the question never arose; now that the
+ * newest directory wins, a reverted version is the newest one there and would be picked straight
+ * back up -- and because the revert leaves `active` null, nothing health-tracks it or reverts it a
+ * second time. That turns a visible ENOENT into a silently broken runtime with no recovery, which
+ * is worse than the bug this fallback was written for.
+ *
+ * `pending` is staged into its versioned directory before the restart that activates it. Adopting
+ * it early would run a version that has not been through activation, so it gets no health tracking
+ * or rollback either.
+ */
+export function ineligibleBaselineVersions(entry: ILocalComponentEntry | undefined): string[] {
+	const out: string[] = [];
+	for (const failed of entry?.failed ?? []) {
+		if (failed?.version) {
+			out.push(failed.version);
+		}
+	}
+	if (entry?.pending?.version) {
+		out.push(entry.pending.version);
+	}
+	return out;
+}
+
+/**
+ * Compares two version strings (e.g. `2201.13.4`, `5.0.0.1`, `5.1.3-testalpha1`).
+ * Returns 1 if a > b, -1 if a < b, 0 if equal. Non-numeric release segments compare as 0.
+ *
+ * A pre-release ranks BELOW the release it precedes, per semver §11.3: `5.1.3-testalpha1` < `5.1.3`.
+ * Treating them as equal — which is what comparing only the leading digits of each segment did —
+ * strands anyone on a pre-release build: the release that supersedes it never compares as newer, so
+ * it is never offered, permanently. Our own test builds are pre-releases, so this is not a corner
+ * case.
+ *
+ * The update server mirrors this exactly (decide.bal). Both sides MUST agree on what "newer" means
+ * or the server offers an update the client then refuses.
+ */
+export function compareVersions(a: string, b: string): number {
+	const [coreA, preA] = splitVersion(a);
+	const [coreB, preB] = splitVersion(b);
+	const pa = coreA.split('.');
+	const pb = coreB.split('.');
+	const len = Math.max(pa.length, pb.length);
+	for (let i = 0; i < len; i++) {
+		const na = parseInt(pa[i] ?? '0', 10) || 0;
+		const nb = parseInt(pb[i] ?? '0', 10) || 0;
+		if (na > nb) {
+			return 1;
+		}
+		if (na < nb) {
+			return -1;
+		}
+	}
+	if (!preA && !preB) {
+		return 0;
+	}
+	// Same release core, so whichever carries no pre-release is the finished one and ranks above.
+	if (!preA) {
+		return 1;
+	}
+	if (!preB) {
+		return -1;
+	}
+	return comparePreRelease(preA, preB);
+}
+
+/**
+ * Whitespace-separated comparators, all of which must hold: ">=5.1.0 <5.2.0". Mirrors the server's
+ * satisfiesRange so both sides agree. An unrecognised comparator is accepted rather than failing
+ * closed on a range this client is simply too old to understand; `onUnrecognized` lets a caller
+ * log it.
+ *
+ * Lives here rather than in the update service because activation runs in the bootstrap, before
+ * any service exists, and must apply exactly the rules that decided what to stage.
+ */
+export function satisfiesRange(version: string, range: string, onUnrecognized?: (comparator: string) => void): boolean {
+	for (const comparator of range.trim().split(/\s+/).filter(Boolean)) {
+		// The version part must actually look like a version: without this the regex matches any
+		// token, so a range written for a richer grammar (`^5.1.0`, `~5.1`) would compare garbage
+		// and fail CLOSED -- withholding the component -- instead of taking the documented
+		// accept-what-we-don't-understand path.
+		const match = /^(>=|<=|>|<|==|=)?\s*([0-9][0-9A-Za-z.+_-]*)$/.exec(comparator);
+		if (!match) {
+			onUnrecognized?.(comparator);
+			continue;
+		}
+		const op = match[1] ?? '=';
+		const cmp = compareVersions(version, match[2]);
+		const satisfied = op === '>=' ? cmp >= 0
+			: op === '>' ? cmp > 0
+				: op === '<=' ? cmp <= 0
+					: op === '<' ? cmp < 0
+						: cmp === 0;
+		if (!satisfied) {
+			return false;
+		}
+	}
+	return true;
+}
+
+/**
+ * The version to stage components for once an app update is downloaded, or undefined when there is
+ * nothing to do. Only a strictly newer, well-formed version qualifies: the same version is already
+ * what the regular check asks as, and anything older or unparseable would fetch components for an
+ * app that is not coming.
+ */
+export function incomingAppVersionToPrepare(incomingVersion: string | undefined, runningAppVersion: string): string | undefined {
+	if (!incomingVersion || !VERSION_DIR_RE.test(incomingVersion)) {
+		return undefined;
+	}
+	return compareVersions(incomingVersion, runningAppVersion) > 0 ? incomingVersion : undefined;
+}
+
+/**
+ * Waits for `work`, but stops waiting once it has gone `stallMs` without progress, as reported by
+ * `lastActivity()` (a `Date.now()` timestamp). Resolves true when `work` settled, either way, and
+ * false on a stall; the work itself carries on regardless. Not a deadline: work that keeps moving is
+ * waited for however long it takes.
+ */
+export async function untilSettledOrStalled(work: Promise<unknown>, lastActivity: () => number, stallMs: number): Promise<boolean> {
+	let timer: ReturnType<typeof setTimeout> | undefined;
+	const stalled = new Promise<boolean>(resolve => {
+		const check = () => {
+			const idle = Date.now() - lastActivity();
+			if (idle >= stallMs) {
+				resolve(false);
+				return;
+			}
+			timer = setTimeout(check, stallMs - idle);
+		};
+		timer = setTimeout(check, stallMs);
+	});
+	try {
+		return await Promise.race([work.then(() => true, () => true), stalled]);
+	} finally {
+		clearTimeout(timer);
+	}
+}
+
+/**
+ * Extensions whose deferred copy is still on its way in, as far as offers for `appVersion` go: the
+ * copy's `app` requirement is met by `appVersion` or by the app update this run prepared for. Those
+ * stand in for an offer at or below their version. A copy waiting for an app that is not coming does
+ * not: it must not keep the running app from a compatible fix, the same rule stagedPendingComponents
+ * applies to runtimes. A copy with no `app` requirement (recorded before they were pinned) counts.
+ */
+export function awaitingDeferredExtensions(manifest: ILocalComponentsManifest, appVersion: string | undefined, preparedAppVersion?: string): Set<string> {
+	const awaiting = new Set<string>();
+	for (const [id, entry] of Object.entries(manifest.components)) {
+		const deferred = entry?.deferredExtension;
+		if (!deferred) {
+			continue;
+		}
+		const range = deferred.requires?.app;
+		const meets = (version: string | undefined) => !!version && !!range && satisfiesRange(version, range);
+		if (!range || meets(appVersion) || meets(preparedAppVersion)) {
+			awaiting.add(id);
+		}
+	}
+	return awaiting;
+}
+
+/**
+ * Deletes downloaded extensions under `stagingHome` that no deferred entry refers to, returning what
+ * it removed as `id@version`. Only directories holding exactly `<id>-<version>.vsix` are touched, so
+ * runtime archives kept there for a retry are left alone. Meant for startup, before any window: a
+ * VSIX staged in an earlier run is never installed by this one unless it is deferred, so anything
+ * else there is a leftover -- a download that did not finish being recorded, or a renderer install
+ * the app quit before.
+ */
+export function sweepStagedExtensionDownloads(stagingHome: string, manifest: ILocalComponentsManifest | undefined): string[] {
+	const removed: string[] = [];
+	let ids: string[];
+	try {
+		ids = fs.readdirSync(stagingHome, { withFileTypes: true }).filter(e => e.isDirectory()).map(e => e.name);
+	} catch {
+		return removed;
+	}
+	for (const id of ids) {
+		let versions: string[];
+		try {
+			versions = fs.readdirSync(path.join(stagingHome, id), { withFileTypes: true }).filter(e => e.isDirectory()).map(e => e.name);
+		} catch {
+			continue;
+		}
+		for (const version of versions) {
+			const dir = path.join(stagingHome, id, version);
+			if (manifest?.components[id]?.deferredExtension?.version === version) {
+				continue;
+			}
+			let entries: string[];
+			try {
+				entries = fs.readdirSync(dir);
+			} catch {
+				continue;
+			}
+			if (entries.length === 1 && entries[0] === `${id}-${version}.vsix`) {
+				try {
+					fs.rmSync(dir, { recursive: true, force: true });
+					removed.push(`${id}@${version}`);
+				} catch {
+					// Left for the next startup.
+				}
+			}
+		}
+	}
+	return removed;
+}
+
+/** A deferred extension to install now, with its VSIX path as recorded (see ILocalComponentEntry). */
+export interface IDeferredExtensionInstall {
+	readonly id: string;
+	readonly version: string;
+	readonly path: string;
+}
+
+/**
+ * What to do, at boot, with each extension downloaded for an app update. `install` what this app
+ * meets the requirements of; `discard` what it already has at that version or newer (the new app
+ * may bundle it); anything else stays deferred, since the app it waits for may still come.
+ *
+ * `installedVersion` answers for extensions and runtimes alike, after runtime activation has run.
+ * As in heldBackPendingComponents, `app` requirements are not evaluated without a running version.
+ */
+export function decideDeferredExtensions(
+	manifest: ILocalComponentsManifest,
+	runningAppVersion: string | undefined,
+	installedVersion: (id: string) => string | undefined
+): { readonly install: IDeferredExtensionInstall[]; readonly discard: { readonly id: string; readonly version: string }[] } {
+	const install: IDeferredExtensionInstall[] = [];
+	const discard: { id: string; version: string }[] = [];
+	for (const [id, entry] of Object.entries(manifest.components)) {
+		const deferred = entry.deferredExtension;
+		if (!deferred) {
+			continue;
+		}
+		const installed = installedVersion(id);
+		if (!deferred.path || (installed && compareVersions(deferred.version, installed) <= 0)) {
+			discard.push({ id, version: deferred.version });
+			continue;
+		}
+		const met = Object.entries(deferred.requires ?? {}).every(([depId, range]) => {
+			if (depId === 'app' && !runningAppVersion) {
+				return true;
+			}
+			const depVersion = depId === 'app' ? runningAppVersion : installedVersion(depId);
+			return !!depVersion && satisfiesRange(depVersion, range);
+		});
+		if (met) {
+			install.push({ id, version: deferred.version, path: deferred.path });
+		}
+	}
+	return { install, discard };
+}
+
+/**
+ * Staged components that must NOT activate on the app that is running, keyed by id, with the reason.
+ *
+ * A component is staged against one app and activated by whichever app boots next. Normally those
+ * are the same, but not always: an app update can land between staging and the restart (possibly
+ * onto a different release line), or a component staged for an incoming app can meet a restart in
+ * which that app update did not apply. Activating it anyway puts a component on an app it was not
+ * built for -- exactly what the server refuses to do when it offers ("a component that needs the
+ * newer app must not land on the older one"). So its `app` requirement is checked against the app
+ * actually running, and a component that fails is held: left pending, not discarded, so it
+ * activates once the right app is up.
+ *
+ * A requirement on another component is checked against the version that component will RUN after
+ * this pass -- its pending version if that activates, otherwise its active one -- and a dependent
+ * that would not be satisfied is held too, to a fixpoint. That is what stops a dependent activating
+ * against an older dependency, whether the newer one is held, discarded for a missing directory
+ * (`isStaged`), or was already dropped on an earlier boot. A held or discarded dependency with no
+ * version to fall back on counts as unmet. A dependency this manifest does not track at all was
+ * checked when the dependent was offered, and is not re-checked here.
+ *
+ * With no running version to compare against, `app` requirements are not evaluated: nothing could
+ * ever satisfy them, and holding forever is worse than the unguarded behaviour this replaces.
+ */
+export function heldBackPendingComponents(
+	manifest: ILocalComponentsManifest,
+	runningAppVersion: string | undefined,
+	isStaged: (pending: ILocalComponentVersion) => boolean = () => true
+): Map<string, string> {
+	const held = new Map<string, string>();
+	const discarded = new Set(Object.entries(manifest.components)
+		.filter(([, entry]) => entry?.pending && !isStaged(entry.pending))
+		.map(([id]) => id));
+	const activates = (id: string) => !!manifest.components[id]?.pending && !held.has(id) && !discarded.has(id);
+	let grew = true;
+	while (grew) {
+		grew = false;
+		for (const [id, entry] of Object.entries(manifest.components)) {
+			const requires = entry?.pending?.requires;
+			if (!requires || !activates(id)) {
+				continue;
+			}
+			for (const [dep, range] of Object.entries(requires)) {
+				let unmet: string | undefined;
+				if (dep === 'app') {
+					if (runningAppVersion && !satisfiesRange(runningAppVersion, range)) {
+						unmet = `needs app ${range}, running ${runningAppVersion}`;
+					}
+				} else {
+					const depEntry = manifest.components[dep];
+					if (!depEntry) {
+						continue;
+					}
+					const depPending = depEntry.pending;
+					const depVersion = depPending && activates(dep) ? depPending.version : (depEntry.active?.version ?? depEntry.bundledVersion);
+					const replaced = !!depPending && !activates(dep);
+					if (depVersion ? !satisfiesRange(depVersion, range) : replaced) {
+						unmet = `needs ${dep} ${range}, which would run ${depVersion ?? 'no version'}`;
+					}
+				}
+				if (unmet) {
+					held.set(id, unmet);
+					grew = true;
+					break;
+				}
+			}
+		}
+	}
+	return held;
+}
+
+/**
+ * Pins components just staged for an app update to that app: any of `staged` still pending at that
+ * version without an `app` requirement gets `>=appVersion`. They came from the incoming release's
+ * document, and without the pin activation would run one on whichever app boots next -- including
+ * the old app, if the update does not install. Done on the recorded entry, never on the offer, whose
+ * `requires` must keep matching its signed statement. Returns whether anything changed.
+ */
+export function pinPendingToApp(manifest: ILocalComponentsManifest, staged: readonly { readonly id: string; readonly version: string }[], appVersion: string): boolean {
+	let changed = false;
+	for (const { id, version } of staged) {
+		const entry = manifest.components[id];
+		const pending = entry?.pending;
+		if (pending && pending.version === version && !pending.requires?.app) {
+			entry.pending = { ...pending, requires: { ...pending.requires, app: `>=${appVersion}` } };
+			changed = true;
+		}
+	}
+	return changed;
+}
+
+/**
+ * Pending components that count as already staged when deciding what to offer for `appVersion`:
+ * those that app would activate, plus, once an app update has been prepared for, those staged for
+ * it. The second kind are held on the running app on purpose -- they wait for the restart into the
+ * update -- so an older version the running app could take must not replace one, or the restart
+ * arrives without it. A pending held for an app that is NOT coming does not count: it must not keep
+ * the running app from a compatible update.
+ */
+export function stagedPendingComponents(manifest: ILocalComponentsManifest, appVersion: string | undefined, preparedAppVersion?: string): Set<string> {
+	const heldNow = heldBackPendingComponents(manifest, appVersion);
+	const heldForUpdate = preparedAppVersion ? heldBackPendingComponents(manifest, preparedAppVersion) : undefined;
+	const staged = new Set<string>();
+	for (const [id, entry] of Object.entries(manifest.components)) {
+		if (entry?.pending && (!heldNow.has(id) || (heldForUpdate && !heldForUpdate.has(id)))) {
+			staged.add(id);
+		}
+	}
+	return staged;
+}
+
+/** Splits `5.1.3-alpha.2+build` into its release core and pre-release; build metadata is dropped. */
+function splitVersion(version: string): [string, string] {
+	const trimmed = version.trim();
+	const plus = trimmed.indexOf('+');
+	const withoutBuild = plus === -1 ? trimmed : trimmed.slice(0, plus);
+	const dash = withoutBuild.indexOf('-');
+	return dash === -1 ? [withoutBuild, ''] : [withoutBuild.slice(0, dash), withoutBuild.slice(dash + 1)];
+}
+
+/** Dot-separated pre-release identifiers: numeric compare numerically and rank below alphanumeric. */
+function comparePreRelease(a: string, b: string): number {
+	const ia = a.split('.');
+	const ib = b.split('.');
+	const len = Math.max(ia.length, ib.length);
+	for (let i = 0; i < len; i++) {
+		const x = ia[i];
+		const y = ib[i];
+		if (x === undefined) {
+			return -1; // a smaller set of identifiers ranks lower: alpha < alpha.1
+		}
+		if (y === undefined) {
+			return 1;
+		}
+		const nx = /^\d+$/.test(x) ? parseInt(x, 10) : undefined;
+		const ny = /^\d+$/.test(y) ? parseInt(y, 10) : undefined;
+		if (nx !== undefined && ny !== undefined) {
+			if (nx !== ny) {
+				return nx < ny ? -1 : 1;
+			}
+			continue;
+		}
+		if (nx !== undefined) {
+			return -1;
+		}
+		if (ny !== undefined) {
+			return 1;
+		}
+		if (x !== y) {
+			return x < y ? -1 : 1;
+		}
+	}
+	return 0;
+}
