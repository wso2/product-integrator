+
+		// The app update's own prompt. The main process reports Ready only once the runtimes that
+		// version needs are staged too (see prepareForAppUpdate), so this is the moment everything is
+		// in place, and the single prompt that covers app and components alike.
+		this._register(this.stockUpdateService.onStateChange(state => {
+			if (state.type === StateType.Ready) {
+				void this.promptRestartForAppUpdate();
+			} else {
+				this.appUpdatePrompted = false;
+			}
+		}));
+
+		// Where the stock command is the only "Check for Updates" users see, it has to check
+		// components too. Both the Command Palette entry and the application-menu item route
+		// through the stock service, so hooking its explicit check covers both surfaces.
+		if (stockUpdateServiceOwnsChecks) {
+			this._register(this.stockUpdateService.onStateChange(state => {
+				if (state.type === StateType.CheckingForUpdates && state.explicit) {
+					this.runCombinedExplicitCheck();
+				}
+			}));
+		}
+	}
+
+	/**
+	 * One restart prompt, not two competing ones.
+	 *
+	 * A component update finishing while the core app is mid-download used to prompt immediately,
+	 * and its "Restart" runs `hostService.restart()` — a plain restart, not the Squirrel apply path
+	 * (`quitAndInstall`). Taking it restarts without applying the app update, and at worst abandons
+	 * a download still in flight. So while the stock updater is working, say nothing and let a
+	 * single prompt cover both once it is ready, with the action that actually applies the update.
+	 *
+	 * Components activate on the next launch either way, so whichever restart happens carries them.
+	 */
+	private promptRestartForComponents(): void {
+		// A deny-list, not an allow-list. Listing the in-flight states means a state upstream adds
+		// later falls through and prompts early, reintroducing this bug for it; listing the settled
+		// ones means an unrecognised state simply waits, which is the safe way to be wrong.
+		const appUpdateSettled = (type: StateType) =>
+			type === StateType.Idle
+			|| type === StateType.Disabled
+			|| type === StateType.Uninitialized;
+		const appUpdateInFlight = (type: StateType) => type !== StateType.Ready && !appUpdateSettled(type);
+
+		const promptComponentsOnly = () => this.notificationService.prompt(
+			Severity.Info,
+			localize('wso2.updates.restart', "Restart WSO2 Integrator to finish updating components."),
+			[{ label: localize('wso2.updates.restartNow', "Restart"), run: () => this.hostService.restart() }]
+		);
+		const current = this.stockUpdateService.state.type;
+		if (current === StateType.Ready) {
+			void this.promptRestartForAppUpdate();
+			return;
+		}
+		if (!appUpdateInFlight(current)) {
+			promptComponentsOnly();
+			return;
+		}
+
+		// One wait at a time. A second component batch finishing while the first is still waiting
+		// would otherwise arm a second listener, and both would fire on Ready -- two prompts, which
+		// is the bug this method exists to prevent. The store is deliberately NOT registered on the
+		// contribution: this method runs repeatedly, and CLAUDE.md forbids accumulating per-call
+		// disposables there. It disposes itself on every exit, including the timeout.
+		if (this.restartPromptWait) {
+			return;
+		}
+		const store = new DisposableStore();
+		this.restartPromptWait = store;
+		const done = (prompt: () => void) => {
+			if (this.restartPromptWait !== store) {
+				return;
+			}
+			this.restartPromptWait = undefined;
+			store.dispose();
+			prompt();
+		};
+		store.add(this.stockUpdateService.onStateChange(next => {
+			if (next.type === StateType.Ready) {
+				done(() => void this.promptRestartForAppUpdate());
+			} else if (!appUpdateInFlight(next.type)) {
+				done(promptComponentsOnly);
+			}
+		}));
+		// Bounded, but slow is not stalled. The Squirrel payload is hundreds of megabytes and
+		// darwin reports `Downloading` with no progress events, so a deadline counted from the
+		// start of the wait fires mid-download on any ordinary connection -- showing the
+		// components-only prompt, whose Restart abandons the download, which is precisely the
+		// behaviour this method removes. So only give up in a state that is not still moving; a
+		// download that genuinely fails reports Idle and the listener above handles it.
+		let timer: ReturnType<typeof setTimeout>;
+		const giveUpIfStuck = () => {
+			if (isAppUpdateProgressing(this.stockUpdateService.state.type)) {
+				timer = setTimeout(giveUpIfStuck, RESTART_PROMPT_WAIT_MS);
+				return;
+			}
+			done(promptComponentsOnly);
+		};
+		timer = setTimeout(giveUpIfStuck, RESTART_PROMPT_WAIT_MS);
+		store.add(toDisposable(() => clearTimeout(timer)));
+	}
+
+	/**
+	 * The restart prompt for an app update that is Ready, covering any staged components with it.
+	 * Once per Ready, whichever of the stock state or a finished component download asks first, and
+	 * only in the window the user was last in -- every window sees the same events.
+	 */
+	private async promptRestartForAppUpdate(): Promise<void> {
+		const state = this.stockUpdateService.state;
+		if (this.appUpdatePrompted || state.type !== StateType.Ready) {
+			return;
+		}
+		this.appUpdatePrompted = true;
+		// Called from event listeners without an await, so nothing may escape as a rejection.
+		let lastFocused: boolean;
+		try {
+			lastFocused = await this.hostService.hadLastFocus();
+		} catch (err) {
+			this.logService.error('[wso2Update] could not tell which window to prompt in', err);
+			lastFocused = true; // two prompts beat none
+		}
+		if (!lastFocused) {
+			return;
+		}
+		const version = state.update.productVersion;
+		this.notificationService.prompt(
+			Severity.Info,
+			version
+				? localize('wso2.updates.appReadyVersion', "WSO2 Integrator {0} is ready. Restart to finish updating.", version)
+				: localize('wso2.updates.appReady', "A WSO2 Integrator update is ready. Restart to finish updating."),
+			[{ label: localize('wso2.updates.restartNow', "Restart"), run: () => this.restartIntoAppUpdate() }]
+		);
+	}
+
+	/**
+	 * `quitAndInstall()` returns without doing anything unless the state is still Ready, and on
+	 * darwin its first call runs an overwrite check that postpones the restart when a newer build
+	 * turns up. Either way the notification is already dismissed, so a bare call can leave the user
+	 * with staged components, no restart and no prompt.
+	 *
+	 * Two paths, and neither can end in silence. When the apply path will not run, a plain restart
+	 * still applies the staged components and cannot decline the way quitAndInstall can, so there is
+	 * nothing to re-ask about. When it does run but declines -- or when anything throws -- the prompt
+	 * goes back up.
+	 */
+	private async restartIntoAppUpdate(): Promise<void> {
+		try {
+			if (this.stockUpdateService.state.type !== StateType.Ready) {
+				await this.hostService.restart();
+				return;
+			}
+			await this.stockUpdateService.quitAndInstall();
+			if (!isAppUpdateProgressing(this.stockUpdateService.state.type)) {
+				this.appUpdatePrompted = false;
+				this.promptRestartForComponents();
+			}
+		} catch (err) {
+			// IPromptChoice.run is `() => void`, so a rejection escaping here would surface as an
+			// unhandled rejection and the user would be left with no way to retry.
+			this.logService.error('[wso2Update] restart after update failed', err);
+			this.appUpdatePrompted = false;
+			this.promptRestartForComponents();
+		}
+	}
+
+	/**
+	 * One click, one answer. On macOS the stock command is the only "Check for Updates" entry, so it
+	 * covers both the core app (Squirrel) and the bundled components. The stock "no updates available"
+	 * dialog is suppressed for this case in the update contribution, because it resolves before the
+	 * component check finishes and would be contradicted by a component-update notification moments
+	 * later. Anything actually found announces itself — Squirrel prompts to restart once its download
+	 * is ready, components go through notifyAvailable() — so this reports only the all-clear.
+	 */
+	private async runCombinedExplicitCheck(): Promise<void> {
+		if (this.explicitCheckInFlight) {
+			return;
+		}
+		this.explicitCheckInFlight = true;
+		// An explicit click should always say something, even for a set already announced by an
+		// earlier background check.
+		this.lastNotifiedKey = undefined;
+		try {
+			const [stockState] = await Promise.all([
+				raceTimeout(this.waitForStockSettle(), 60_000),
+				this.updateService.checkForUpdates(true).catch(err => {
+					this.logService.error('[wso2Update] component check alongside the stock check failed', err);
+				})
+			]);
+			const componentState = await this.updateService.getState();
+			// A timed-out stock check leaves the core-app outcome unknown, so stay silent rather than
+			// claim an all-clear we cannot vouch for.
+			if (stockState?.type === StateType.Idle && componentState.type === Wso2UpdateStateType.Idle) {
+				this.notificationService.info(localize('wso2.updates.allUpToDate', "WSO2 Integrator is up to date."));
+			}
+		} finally {
+			this.explicitCheckInFlight = false;
+		}
+	}
+
+	private waitForStockSettle(): Promise<UpdateState> {
+		if (this.stockUpdateService.state.type !== StateType.CheckingForUpdates) {
+			return Promise.resolve(this.stockUpdateService.state);
+		}
+		return new Promise<UpdateState>(resolve => {
+			// Scoped to this call, not the contribution: registering per check would accumulate
+			// listeners for the lifetime of the window.
+			const store = new DisposableStore();
+			store.add(this.stockUpdateService.onStateChange(state => {
+				if (state.type !== StateType.CheckingForUpdates) {
+					store.dispose();
+					resolve(state);
+				}
+			}));
+		});
+	}
+
+	private onStateChange(state: Wso2UpdateState, isInitial = false): void {
+		// Feed the SHARED title-bar indicator and tooltip. Components used to own a second button
+		// beside the core app's, so a machine with both pending showed two things labelled "Update";
+		// and downloads were invisible, so hundreds of megabytes moved with nothing on screen.
+		setComponentUpdateSummary(
+			state.type === Wso2UpdateStateType.Downloading
+				? { available: 0, progress: state.progress }
+				: state.type === Wso2UpdateStateType.UpdatesAvailable
+					? { available: state.updates.length, commandId: 'wso2.updates.applyAll' }
+					: undefined);
+
+		this.availableContext.set(state.type === Wso2UpdateStateType.UpdatesAvailable);
+
+		// The main process persists its state across a window reload. On the initial
+		// replay only sync the title-bar indicator — do NOT re-notify or re-install,
+		// otherwise a `Downloaded` state would re-prompt on every reload. The same goes for a state
+		// the main process puts back after other work: it was announced already.
+		if (isInitial || ((state.type === Wso2UpdateStateType.Downloaded || state.type === Wso2UpdateStateType.Error) && state.replayed)) {
+			return;
+		}
+
+		if (state.type === Wso2UpdateStateType.UpdatesAvailable) {
+			this.notifyAvailable(state);
+		} else if (state.type === Wso2UpdateStateType.Downloaded) {
+			void this.onDownloaded(state);
+		} else if (state.type === Wso2UpdateStateType.Error) {
+			this.notificationService.error(localize('wso2.updates.error', "Component update failed: {0}", state.message));
+		}
+	}
+
+	private notifyAvailable(state: Extract<Wso2UpdateState, { type: Wso2UpdateStateType.UpdatesAvailable }>): void {
+		// De-duplicate so background checks that keep returning the same set don't re-toast.
+		const key = [
+			...state.updates.map(u => `${u.id}@${u.toVersion}`),
+			state.appUpdate ? `app@${state.appUpdate.version}` : ''
+		].sort().join('|');
+		if (key === this.lastNotifiedKey) {
+			return;
+		}
+		this.lastNotifiedKey = key;
+
+		const names = state.updates.map(u => `${u.id} ${u.toVersion}`).join(', ');
+		const message = state.updates.length
+			? localize('wso2.updates.available', "Updates are available for WSO2 Integrator components: {0}", names)
+			: localize('wso2.updates.appAvailable', "A new version of WSO2 Integrator is available: {0}", state.appUpdate!.version);
+
+		const actions: IPromptChoice[] = [];
+		if (state.updates.length) {
+			actions.push({ label: localize('wso2.updates.updateAll', "Update All"), run: () => this.commandService.executeCommand('wso2.updates.applyAll') });
+		}
+		if (state.appUpdate) {
+			const appUpdate = state.appUpdate;
+			const label = isWindows ? localize('wso2.updates.updateApp', "Update") : localize('wso2.updates.downloadApp', "Download");
+			actions.push({ label, run: () => applyAppUpdate(this.updateService, this.dialogService, this.notificationService, appUpdate.version) });
+		}
+		actions.push({ label: localize('wso2.updates.showDetails', "Show Details"), run: () => this.commandService.executeCommand('wso2.updates.showComponents') });
+
+		this.notificationService.prompt(Severity.Info, message, actions);
+	}
+
+	private async onDownloaded(state: Extract<Wso2UpdateState, { type: Wso2UpdateStateType.Downloaded }>): Promise<void> {
+		let installed = 0;
+		let failed = 0;
+		for (const ext of state.stagedExtensions) {
+			try {
+				// Every window sees this event; the main process grants the install to exactly one.
+				if (!await this.updateService.claimStagedExtension(ext.id, ext.version)) {
+					continue;
+				}
+				await this.extensionManagementService.install(URI.file(ext.vsixPath), { isBuiltin: true, pinned: true });
+				await this.updateService.recordExtensionInstalled(ext.id, ext.version);
+				installed++;
+			} catch (err) {
+				failed++;
+				this.logService.error(`[wso2Update] failed to install ${ext.id}@${ext.version}`, err);
+			}
+		}
+
+		// The staged work is applied, so leave the Downloaded state behind — otherwise the menu keeps
+		// offering "Restart to Finish Updating Components" for extensions that are already installed.
+		// A pending runtime keeps that state (restartRequired), since it really does need the restart.
+		// Not awaited: it waits for the update lock, which preparing for an app update can hold for as
+		// long as its download keeps moving, and nothing below depends on it.
+		void this.updateService.stagedExtensionsApplied()
+			.catch(err => this.logService.error('[wso2Update] failed to clear the downloaded state', err));
+
+		if (failed > 0) {
+			this.notificationService.error(localize('wso2.updates.installFailed', "{0} component update(s) could not be installed. See the log (WSO2 Integrator) for details.", failed));
+		}
+
+		if (state.restartRequired) {
+			this.promptRestartForComponents();
+		} else if (installed > 0) {
+			this.notificationService.prompt(Severity.Info, localize('wso2.updates.reload', "Reload the window to finish updating components."), [
+				{ label: localize('wso2.updates.reloadNow', "Reload Window"), run: () => this.hostService.reload() }
+			]);
+		}
+	}
+}
+
+registerWorkbenchContribution2(Wso2UpdateContribution.ID, Wso2UpdateContribution, WorkbenchPhase.Eventually);
+
+//#endregion
