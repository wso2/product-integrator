+		const result = await untilSettledOrStalled(new Promise<void>(() => { }), () => started, STALL_MS);
+		// The work never settles, so resolving at all shows it was not waited for; the bound shows
+		// the wait did not give up early.
+		strictEqual(result, false);
+		strictEqual(Date.now() - started >= STALL_MS, true);
+	});
+
+	test('keeps waiting, past the stall window, for work that keeps moving', async () => {
+		let activity = Date.now();
+		const ticker = setInterval(() => activity = Date.now(), STALL_MS / 4);
+		try {
+			const started = Date.now();
+			const result = await untilSettledOrStalled(after(STALL_MS * 3), () => activity, STALL_MS);
+			strictEqual(result, true);
+			strictEqual(Date.now() - started >= STALL_MS * 3 - 5, true);
+		} finally {
+			clearInterval(ticker);
