+import { strictEqual } from 'assert';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../base/test/common/utils.js';
+import { compareVersions } from '../../node/wso2ComponentsManifest.js';
+
+suite('wso2ComponentsManifest - compareVersions', () => {
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	// The SAME vector table lives in the update server's decide_test.bal. Both sides decide what
+	// "newer" means — the server when choosing what to offer, the client when deciding whether to
+	// accept it — so a divergence shows up as a check that finds an update and then does nothing.
+	// Change one of these tables only by changing both.
+	const vectors: [string, string, number][] = [
+		['5.1.3-testalpha1', '5.1.3', -1],           // a pre-release ranks below its release
+		['5.1.3', '5.1.3-testalpha1', 1],
+		['5.1.3-testalpha1', '5.1.3-testalpha1', 0],
+		['5.1.3-testalpha1', '5.1.3-testalpha2', -1],
+		['2201.13.6-alpha2', '2201.13.6', -1],
+		['2201.13.6-Alpha', '2201.13.6-alpha2', -1], // ASCII order: uppercase sorts first
+		['2201.13.4', '2201.13.5', -1],
+		['5.0.0.1', '5.0.0.2', -1],                  // 4-part versions
+		['5.0.0.1', '5.0.0', 1],
+		['5.12.4', '5.13.26081016', -1],
+		['1.0.0-alpha', '1.0.0-alpha.1', -1],        // fewer identifiers rank lower
+		['1.0.0-alpha.1', '1.0.0-alpha.beta', -1],   // numeric ranks below alphanumeric
+		['1.0.0-beta', '1.0.0-beta.2', -1],
+		['1.0.0-beta.2', '1.0.0-beta.11', -1],       // numeric, not lexical: 2 < 11
+		['1.0.0-rc.1', '1.0.0', -1],
+		['5.1.3+build9', '5.1.3', 0],                // build metadata is ignored
+		['5.1.0', '5.1', 0]                          // missing segments are zero
+	];
+
+	test('orders versions the same way the update server does', () => {
+		for (const [a, b, expected] of vectors) {
+			strictEqual(compareVersions(a, b), expected, `compareVersions('${a}', '${b}')`);
+			// Antisymmetry: asked the other way round, the answer must invert. A comparator that
+			// fails this can report both "a is newer" and "b is newer", which would let an update
+			// be offered and refused at the same time.
+			strictEqual(compareVersions(b, a), -expected, `compareVersions('${b}', '${a}')`);
+		}
+	});
+
+	test('a pre-release build is offered the release that supersedes it', () => {
+		// The regression this table exists for: our own test builds are pre-releases, and while
+		// these compared equal the release never looked newer, so it was never offered — the client
+		// sat on a pre-release permanently.
+		strictEqual(compareVersions('5.1.3', '5.1.3-testalpha1') > 0, true);
+	});
+});
