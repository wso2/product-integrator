+export const IWso2ComponentUpdateService = createDecorator<IWso2ComponentUpdateService>('wso2ComponentUpdateService');
+
+/**
+ * Component kinds delivered by the WSO2 update server. `extension` components are
+ * installed as user-extension shadow copies; `runtime` components (Ballerina
+ * runtime, custom JRE, ICP) are staged into versioned directories and activated
+ * at the next startup.
+ */
+export type Wso2ComponentKind = 'extension' | 'runtime';
+
+/** A signed, downloadable artifact referenced by a manifest entry. */
+export interface IWso2Artifact {
+	readonly url: string;
+	readonly sha256: string;
+	readonly sizeBytes?: number;
+	/**
+	 * Signed provenance for this artifact. `statementUrl` holds a small JSON document binding the
+	 * artifact's IDENTITY to its bytes — `{ id, version, sha256, sizeBytes, requires }` — and
+	 * `sigUrl` is the detached cosign signature over that document, verified against the pinned
+	 * `wso2UpdatePublicKey`.
+	 *
+	 * Signing the statement rather than the bytes is what makes the surrounding manifest
+	 * untrustworthy-by-design: a signature over bytes alone proves only "WSO2 produced this file",
+	 * so a manifest could offer an older signed artifact under a newer version label and the client
+	 * would install it, believe it was current, and then refuse the real fix (its version check only
+	 * moves forward). Binding id+version+digest into the signed document closes that, and carries
+	 * `requires` inside the signature so compatibility constraints cannot be relaxed either.
+	 *
+	 * Present only for artifacts mirrored to the WSO2 update bucket, which is where CI can sign
+	 * them; a third-party source URL has no statement of ours.
+	 */
+	readonly signature?: {
+		readonly statementUrl: string;
+		readonly sigUrl: string;
+	};
+}
+
+/**
+ * What the client reports about itself on an update check. The server decides from this, so it has
+ * to be complete: `components` lists EVERY component the client has, bundled versions included,
+ * because a component the server does not hear about is one it must treat as absent.
+ *
+ * `bucket` is a stable 0-99 slot derived locally from a device id that is deliberately never sent,
+ * so staged rollout works without the server being able to identify the machine.
+ */
+export interface IWso2UpdateCheckRequest {
+	readonly channel: string;
+	readonly platform: string;
+	readonly arch: string;
+	readonly appVersion: string;
+	readonly appCommit?: string;
+	readonly components: { readonly [id: string]: string };
+	readonly bucket: number;
+}
+
+/** One component the server decided this client should take. */
+export interface IWso2ComponentOffer {
+	readonly id: string;
+	readonly kind: Wso2ComponentKind;
+	readonly version: string;
+	readonly artifact: IWso2Artifact;
+	/** Compatibility constraints, re-checked against the artifact's SIGNED statement before install. */
+	readonly requires?: { readonly [id: string]: string };
+	readonly releaseNotesUrl?: string;
+}
+
+/** The core-app offer, carrying whichever payload this platform applies. */
+export interface IWso2AppOffer {
+	readonly version: string;
+	readonly commit?: string;
+	readonly installer: IWso2Artifact;
+	readonly squirrel?: { readonly url: string };
+	readonly releaseNotesUrl?: string;
