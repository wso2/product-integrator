+		const version = running?.version ?? (builtIn.version && builtIn.version !== 'latest' ? builtIn.version : 'Unknown');
+		const updated = !!running && !running.isBuiltin;
+		return `${label}: ${version}${updated ? ' (updated)' : ''}`;
+	});
