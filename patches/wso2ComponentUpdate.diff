+	 * Asks the server what this client should take. The request carries everything the decision
+	 * needs — platform, arch, app version and the FULL component inventory — because the server
+	 * cannot tell "not installed" from "not reported" and fails a dependency check closed.
+	 *
+	 * The response is composed per client and therefore unsigned. That is safe only because every
+	 * artifact it names is verified against its own signed statement before installation, and
+	 * because the offers below are re-checked against local state rather than taken on trust.
+	 *
+	 * `asAppVersion` asks on behalf of an app update that is downloaded but not yet running (see
+	 * prepareForAppUpdate). The server keeps no client state, so asking as that version is
+	 * all it takes to be answered from its release's document. The running build's commit is left
+	 * out then: paired with another version it would describe a build that does not exist.
+	 */
+	private async fetchUpdates(asAppVersion?: string): Promise<IWso2UpdateCheckResponse | undefined> {
+		const url = `${this.updateBaseUrl}/api/v1/updates`;
+		if (!this.isAllowedUrl(url)) {
+			throw new Error(`Update server host not allowed: ${url}`);
+		}
+		const payload: IWso2UpdateCheckRequest = {
+			channel: this.channel,
+			platform: this.platformKey(),
+			arch: this.archKey(),
+			appVersion: asAppVersion ?? this.appVersion(),
+			...(this.productService.commit && !asAppVersion ? { appCommit: this.productService.commit } : {}),
+			components: this.componentInventory(),
+			bucket: this.rolloutBucket()
+		};
+		const context = await this.requestService.request({
+			type: 'POST',
+			url,
+			// followRedirects 0: the request service re-sends the FULL options -- Authorization
+			// included -- to a redirect target, and isAllowedUrl() saw only the original URL. A
+			// redirect would therefore both leave the allowlist and leak the entitlement token.
+			followRedirects: 0,
+			headers: { 'Content-Type': 'application/json', ...(this.authHeaders(url) ?? {}) },
+			data: JSON.stringify(payload),
+			callSite: 'wso2Update.checkForUpdates'
+		}, CancellationToken.None);
+		if (context.res.statusCode === 204) {
+			return undefined; // nothing for this client
+		}
+		if (context.res.statusCode !== 200) {
+			throw new Error(`Unexpected status ${context.res.statusCode} checking for updates`);
+		}
+		const text = (await asText(context)) ?? '';
+		const response = JSON.parse(text) as IWso2UpdateCheckResponse;
+		if (!Array.isArray(response.components)) {
+			throw new Error('Malformed update response: components missing');
+		}
+		return response;
+	}
+
+	/**
+	 * Every component this client has, bundled versions included — runtimes from the product's
+	 * bundled set, extensions from its built-in list, both overlaid with any local override. The
+	 * server treats an unreported component as absent, so an incomplete inventory silently
+	 * withholds anything that depends on it.
+	 */
+	private componentInventory(): { [id: string]: string } {
+		const local = readLocalManifest(this.componentsHome);
+		const inventory: { [id: string]: string } = {};
+		for (const id of Object.keys(this.productService.bundledComponents ?? {})) {
+			const version = this.activeVersion(id, local);
+			if (version) {
+				inventory[id] = version;
+			}
+		}
+		for (const extension of this.productService.builtInExtensions ?? []) {
+			const version = this.activeVersion(extension.name, local) ?? extension.version;
+			if (version) {
+				inventory[extension.name] = version;
+			}
+		}
+		for (const [id, entry] of Object.entries(local?.components ?? {})) {
+			const version = entry.active?.version ?? entry.bundledVersion;
+			if (version && !inventory[id]) {
+				inventory[id] = version;
+			}
+		}
+		return inventory;
+	}
+
+	/**
+	 * This machine's stable 0-99 rollout slot. Derived from the local device id, which is NEVER
+	 * transmitted — the server gets the slot alone, enough to stage a rollout without being able to
+	 * identify the machine. Deliberately not per-component: the server cannot recompute a
+	 * per-component value without the device id, and the cost is that the same machines lead every
+	 * staged rollout.
+	 */
+	private rolloutBucket(): number {
+		return parseInt(createHash('sha1').update(this.deviceId()).digest('hex').slice(0, 8), 16) % 100;
+	}
+
+	/** `appVersion` is the app the offers must suit: the running one unless preparing for an update. */
+	private resolveOfferedUpdates(response: IWso2UpdateCheckResponse, appVersion = this.appVersion()): IWso2AvailableUpdate[] {
+		const local = readLocalManifest(this.componentsHome);
+		const projected = this.projectedVersions(response);
+		const staged = local ? stagedPendingComponents(local, appVersion, this.preparedAppVersion) : new Set<string>();
+		const deferred = local ? awaitingDeferredExtensions(local, appVersion, this.preparedAppVersion) : new Set<string>();
+		const offered: IWso2AvailableUpdate[] = [];
+		for (const component of response.components) {
+			// Trust boundary: these two values become path segments (stage, rm, rename). Refuse a
+			// shape that could traverse rather than sanitizing it -- there is nothing legitimate to
+			// recover from a component id of `..`.
+			if (!isSafePathSegment(component.id) || !isSafePathSegment(component.version)) {
+				this.logService.warn(`[wso2Update] ignoring offer with unsafe id/version: '${component.id}' '${component.version}'`);
+				continue;
+			}
+			const activeVersion = this.activeVersion(component.id, local);
+			// Forward-only, enforced here and not merely upstream: this is what stops a stale or
+			// tampered answer from reinstalling an older component over a newer one.
+			if (activeVersion && compareVersions(component.version, activeVersion) <= 0) {
+				this.logService.info(`[wso2Update] ignoring ${component.id}@${component.version}: not newer than ${activeVersion}`);
+				continue;
+			}
+			// Already downloaded and staged — for the next restart, or for the app update being
+			// prepared — so don't re-offer/re-download. Not when it is held for an app that is not
+			// coming: it must not stand in the way of a compatible update this app can take.
+			const pendingVersion = local?.components[component.id]?.pending?.version;
+			if (pendingVersion && staged.has(component.id) && compareVersions(pendingVersion, component.version) >= 0) {
+				continue;
+			}
+			// Downloaded for an app update and installed when that app boots. Offering it as well
+			// would download it a second time and install it from the renderer in parallel. Not when
+			// the app it waits for is not coming: it must not keep this app from a compatible fix.
+			const deferredVersion = local?.components[component.id]?.deferredExtension?.version;
+			if (deferredVersion && deferred.has(component.id) && compareVersions(deferredVersion, component.version) >= 0) {
+				continue;
+			}
+			// This exact version already stopped the app from booting and was auto-reverted. The
+			// server has no way to know that — the failure is local to this machine — so refusing it
+			// here is what stops an endless revert/re-download loop. A later version is still
+			// offered, since that is how a fix arrives.
+			if (local?.components[component.id]?.failed?.some(f => f.version === component.version)) {
+				this.logService.info(`[wso2Update] ignoring ${component.id}@${component.version}: previously auto-reverted after failing to boot`);
+				continue;
+			}
+			if (!this.requiresSatisfied(component, local, projected, appVersion)) {
+				this.logService.info(`[wso2Update] ignoring ${component.id}@${component.version}: unmet requirements`);
+				continue;
+			}
+			offered.push({
+				id: component.id,
+				kind: component.kind,
+				fromVersion: activeVersion,
+				toVersion: component.version,
+				releaseNotesUrl: component.releaseNotesUrl
+			});
+		}
+		return offered;
+	}
+
+	/**
+	 * Whether a component's `requires` hold for this machine. `app` is compared against the version
+	 * running RIGHT NOW — never one a queued update would reach — because the user may never
+	 * restart, and a component needing the newer app must not land on the older one meanwhile.
+	 *
+	 * The one exception is `appVersion`, passed only when staging for an app update that is already
+	 * downloaded. That is still safe: what it stages is recorded with its `requires`, and activation
+	 * holds it back on any app that does not meet them (heldBackPendingComponents).
+	 */
+	private requiresSatisfied(
+		component: IWso2ComponentOffer,
+		local: ILocalComponentsManifest | undefined,
+		projected: Map<string, string>,
+		appVersion = this.appVersion()
+	): boolean {
+		if (!component.requires) {
+			return true;
+		}
+		for (const [depId, range] of Object.entries(component.requires)) {
+			const depVersion = depId === 'app'
+				? appVersion
+				// No `?? this.bundledVersion(depId)`: with nothing on disk, activeVersion() returns
+				// undefined on purpose, and substituting the declared version here would satisfy a
+				// `requires` against a runtime this machine does not have.
+				: (projected.get(depId) ?? this.activeVersion(depId, local));
+			if (!depVersion) {
+				return false;
+			}
+			if (!satisfiesRange(depVersion, range, c => this.logService.trace(`[wso2Update] unrecognized version comparator '${c}'; accepting`))) {
+				this.logService.info(`[wso2Update] ${component.id}: ${depId} ${depVersion} does not satisfy '${range}'`);
+				return false;
+			}
+		}
+		return true;
+	}
+
+
+	/** The versions this client would be on after taking everything in this answer. */
+	private projectedVersions(response: IWso2UpdateCheckResponse): Map<string, string> {
+		const projected = new Map<string, string>();
+		for (const component of response.components) {
+			projected.set(component.id, component.version);
+		}
+		return projected;
+	}
+
+	private resolveAppUpdate(response: IWso2UpdateCheckResponse): IWso2AvailableAppUpdate | undefined {
+		// On macOS, when the stock update feed is configured the native Squirrel.Mac updater
+		// (darwinUpdateService) owns core-app updates — don't also offer them here.
+		if (process.platform === 'darwin' && this.productService.updateUrl) {
+			return undefined;
+		}
+		const app = response.app;
+		if (!app) {
+			return undefined;
+		}
+		// Forward-only for the app too: the server decided, but this client checks.
+		if (compareVersions(app.version, this.appVersion()) <= 0) {
+			return undefined;
+		}
+		return { version: app.version, installerUrl: app.installer.url, releaseNotesUrl: app.releaseNotesUrl };
+	}
+
+	//#endregion
+
+	//#region download & apply
+
+	async downloadUpdates(componentIds?: readonly string[]): Promise<void> {
+		return this.runExclusive(() => this.doDownloadUpdates(componentIds));
+	}
+
+	private async doDownloadUpdates(componentIds?: readonly string[]): Promise<void> {
+		const response = this.lastResponse;
+		if (!response) {
+			return;
+		}
+
+		// Which of the server's offers to take. Everything flows through resolveOfferedUpdates() so
+		// the explicit-ids path (a single component from the Components view) is held to the same
+		// gates as "download everything": forward-only, not already staged, not auto-reverted,
+		// requirements met. Filtering the raw response by id alone would let a click re-stage the
+		// currently ACTIVE version, whose staging step deletes the live runtime directory first.
+		const eligible = new Set(this.resolveOfferedUpdates(response).map(u => u.id));
+		let targetComponents: IWso2ComponentOffer[];
+		if (componentIds && componentIds.length) {
+			const wanted = new Set(componentIds);
+			targetComponents = response.components.filter(c => wanted.has(c.id) && eligible.has(c.id));
+		} else if (this._state.type === Wso2UpdateStateType.UpdatesAvailable) {
+			const offered = new Set(this._state.updates.map(u => u.id));
+			targetComponents = response.components.filter(c => offered.has(c.id) && eligible.has(c.id));
+		} else {
+			targetComponents = [];
+		}
+
+		if (!targetComponents.length) {
+			return;
+		}
+
+		this.setState({ type: Wso2UpdateStateType.Downloading });
+		try {
+			const { stagedExtensions, restartRequired } = await this.fetchComponents(targetComponents);
+			this.setState({ type: Wso2UpdateStateType.Downloaded, stagedExtensions, restartRequired });
+		} catch (err) {
+			this.logService.error('[wso2Update] download/apply failed', err);
+			this.setState({ type: Wso2UpdateStateType.Error, message: String(err) });
+		}
+	}
+
+	/**
+	 * Downloads and stages `targets` in order, publishing per-component progress. Stops at the first
+	 * failure and throws it; whatever staged before that stays staged. `appVersion` is the app they
+	 * are for, as in resolveOfferedUpdates().
+	 */
+	private async fetchComponents(targets: readonly IWso2ComponentOffer[], appVersion = this.appVersion()): Promise<{ stagedExtensions: IWso2StagedExtension[]; restartRequired: boolean }> {
+		const stagedExtensions: IWso2StagedExtension[] = [];
+		let restartRequired = false;
+		try {
+			const localBefore = readLocalManifest(this.componentsHome);
+			const stagedBefore = localBefore ? stagedPendingComponents(localBefore, appVersion, this.preparedAppVersion) : new Set<string>();
+			for (const [position, component] of targets.entries()) {
+				// Attribute the bytes about to move to this component. `sizeBytes` is what the offer
+				// claimed; when it is absent the UI shows an indeterminate download rather than
+				// inventing a denominator.
+				this.activeDownload = {
+					id: component.id,
+					version: component.version,
+					index: position + 1,
+					total: targets.length,
+					...(component.artifact.sizeBytes !== undefined ? { totalBytes: component.artifact.sizeBytes } : {}),
+					receivedBytes: 0
+				};
+				this.reportProgress(true);
+				if (component.kind === 'extension') {
+					const vsixPath = await this.downloadExtension(component);
+					stagedExtensions.push({ id: component.id, version: component.version, vsixPath });
+				} else {
+					// Already staged at (or above) this version — don't re-download; it just
+					// needs a restart to activate.
+					const pending = localBefore?.components[component.id]?.pending?.version;
+					if (pending && stagedBefore.has(component.id) && compareVersions(pending, component.version) >= 0) {
+						this.logService.info(`[wso2Update] ${component.id}@${component.version} already staged; skipping re-download`);
+						restartRequired = true;
+						continue;
+					}
+					await this.stageRuntime(component);
+					restartRequired = true;
+				}
+			}
+		} finally {
+			this.activeDownload = undefined;
+		}
+		return { stagedExtensions, restartRequired };
+	}
+
+	/**
+	 * Stages the runtime components `incomingVersion` needs, once that app update is downloaded, and
+	 * resolves when that is done. The macOS updater awaits this before announcing the update Ready.
+	 *
+	 * The regular check asks as the RUNNING app, and a release's components require that release's
+	 * app, so an app update used to arrive with none of its runtimes: the editor-only payload carries
+	 * none, and the old app was never offered them. Asking as the incoming version closes the gap.
+	 * Everything staged here is recorded with its `requires`, so if the restart does not install the
+	 * update after all, activation leaves it pending rather than running it on the old app.
+	 *
+	 * Extensions are left to the new app's own startup check. A staged VSIX is installed by whichever
+	 * renderer sees it, which here would be the old app's.
+	 *
+	 * Never rejects, and never holds the app update hostage: a failure resolves (the new app fetches
+	 * what is missing on its own first check), and so does work that stops making progress for
+	 * PREPARE_STALL_MS -- it carries on in the background, but the restart no longer waits for it.
+	 */
+	async prepareForAppUpdate(incomingVersion: string | undefined): Promise<void> {
+		// Same gates as the scheduled checks: this moves hundreds of megabytes unasked.
+		if (!this.updateBaseUrl || this.mode === 'none' || this.mode === 'manual') {
+			return;
+		}
+		const version = incomingAppVersionToPrepare(incomingVersion, this.appVersion());
+		if (!version) {
+			// The same version (a rebuild) needs nothing the regular check would not bring. Anything
+			// else means the feed did not report the WSO2 version it is expected to put in the release
+			// name, and this update will arrive without its runtimes -- worth saying out loud.
+			if (incomingVersion === this.appVersion()) {
+				this.logService.trace(`[wso2Update] app update downloaded (${incomingVersion}); same version, nothing to prepare for`);
+			} else {
+				this.logService.warn(`[wso2Update] app update downloaded, but its version '${incomingVersion ?? ''}' is not a newer WSO2 Integrator version than ${this.appVersion()}; not preparing components for it`);
+			}
+			return;
+		}
+		await this.untilPreparedOrStalled(this.runExclusive(() => this.stageComponentsForAppUpdate(version)), version);
+	}
+
+	/**
+	 * Waits for staging for an app update, but never longer than it keeps making progress, and never
+	 * rejects: the app update must not wait on a component. Work that stalls carries on in the
+	 * background; the new app fetches whatever it did not finish.
+	 */
+	private async untilPreparedOrStalled(work: Promise<void>, version: string): Promise<void> {
+		const settled = work.catch(err => this.logService.warn(`[wso2Update] could not prepare components for app update ${version}; the new app will fetch them`, err));
+		this.lastDownloadActivity = Date.now();
+		if (!await untilSettledOrStalled(settled, () => this.lastDownloadActivity, PREPARE_STALL_MS)) {
+			this.logService.warn(`[wso2Update] preparing for app update ${version} made no progress for ${PREPARE_STALL_MS / 1000}s; no longer holding the update for it`);
+		}
+	}
+
+	/**
+	 * The work behind prepareForAppUpdate(); callers hold runExclusive(). The state is put back
+	 * afterwards rather than left at Downloaded: Downloaded offers a plain restart, which would not
+	 * install the app update these components wait for. The app update's own Ready is the prompt.
+	 */
+	private async stageComponentsForAppUpdate(incomingVersion: string): Promise<void> {
+		this.preparedAppVersion = incomingVersion;
+		const response = await this.fetchUpdates(incomingVersion);
+		// Not lastResponse: that describes the running app, and Show Components and downloadUpdates()
+		// act on it. These offers are for an app that is not running yet.
+		const wanted = new Set(response ? this.resolveOfferedUpdates(response, incomingVersion).map(u => u.id) : []);
+		// An extension the running app can already take goes through the regular check and installs
+		// now. Only one it cannot is downloaded here, to install when the incoming app boots. "Can"
+		// means against what is active on this machine NOW (no projection): an extension that needs a
+		// runtime staged in this very pass cannot run until the restart either.
+		const local = readLocalManifest(this.componentsHome);
+		const nothingProjected = new Map<string, string>();
+		const targets = response?.components.filter(c => wanted.has(c.id)
+			&& (c.kind !== 'extension' || !this.requiresSatisfied(c, local, nothingProjected))) ?? [];
+
+		if (!targets.length) {
+			return;
+		}
+		this.logService.info(`[wso2Update] staging ${targets.map(c => `${c.id}@${c.version}`).join(', ')} for app update ${incomingVersion}`);
+		const before = this._state;
+		this.setState({ type: Wso2UpdateStateType.Downloading });
+		try {
+			const { stagedExtensions } = await this.fetchComponents(targets, incomingVersion);
+			this.recordDeferredExtensions(stagedExtensions, targets, incomingVersion);
+		} finally {
+			// Whatever staged, even before a failure, is for the incoming app only.
+			this.updateLocalManifest(manifest => pinPendingToApp(manifest, targets, incomingVersion));
+			// An extension is recorded only once every target is in. After a failure, one that did
+			// download has no record, and nothing else would ever remove it.
+			const recorded = readLocalManifest(this.componentsHome);
+			for (const c of targets) {
+				if (c.kind === 'extension' && recorded?.components[c.id]?.deferredExtension?.version !== c.version) {
+					this.removeStagedExtension(c.id, c.version);
+				}
+			}
+			this.setState(replayedState(before));
+		}
+	}
+
+	/**
+	 * Records extensions downloaded for an app update, to be installed when it boots. Nothing tells
+	 * the renderer about them: the renderer that would install them now is the old app's. Pinned to
+	 * `incomingVersion` like the runtimes staged with them (pinPendingToApp), so one deferred only for
+	 * a runtime it needs does not install on the old app should that runtime reach it another way.
+	 */
+	private recordDeferredExtensions(staged: readonly IWso2StagedExtension[], offers: readonly IWso2ComponentOffer[], incomingVersion: string): void {
+		if (!staged.length) {
+			return;
+		}
+		const requires = new Map(offers.map(c => [c.id, c.requires]));
+		const superseded: { id: string; version: string }[] = [];
+		this.updateLocalManifest(manifest => {
+			for (const extension of staged) {
+				const entry = manifest.components[extension.id] ?? (manifest.components[extension.id] = {});
+				entry.bundledVersion = entry.bundledVersion ?? this.bundledVersion(extension.id);
+				const previous = entry.deferredExtension?.version;
+				if (previous && previous !== extension.version) {
+					superseded.push({ id: extension.id, version: previous });
+				}
+				const extensionRequires = requires.get(extension.id);
+				entry.deferredExtension = {
+					version: extension.version,
+					path: path.relative(this.dataFolderHome, extension.vsixPath),
+					installedAt: new Date().toISOString(),
+					requires: { ...extensionRequires, app: extensionRequires?.app ?? `>=${incomingVersion}` }
+				};
+			}
+		});
+		for (const { id, version } of superseded) {
+			this.removeStagedExtension(id, version);
+		}
+		this.logService.info(`[wso2Update] deferred ${staged.map(e => `${e.id}@${e.version}`).join(', ')} to the app update`);
+	}
+
+	async whenDeferredExtensionsInstalled(): Promise<void> {
+		await raceTimeout(this.deferredExtensionsInstall, DEFERRED_INSTALL_WAIT_MS, () =>
+			this.logService.warn(`[wso2Update] deferred extensions still installing after ${DEFERRED_INSTALL_WAIT_MS / 1000}s; opening the window without waiting`));
+	}
+
+	/**
+	 * Installs, through the shared process, the extensions that were downloaded for this app while
+	 * the previous one was running. Runs at startup, before any window, so the extension host starts
+	 * on the new versions instead of activating the old ones against the new runtimes.
+	 *
+	 * An install that fails is dropped rather than retried: the next check offers the extension the
+	 * ordinary way. One that this app does not meet the requirements of stays for the app it waits for.
+	 */
+	private async installDeferredExtensions(): Promise<void> {
+		const local = readLocalManifest(this.componentsHome);
+		if (!local) {
+			return;
+		}
+		const { install, discard } = decideDeferredExtensions(local, this.appVersion(), id => this.activeVersion(id, local));
+		for (const { id, version } of discard) {
+			this.logService.info(`[wso2Update] dropping deferred ${id}@${version}: already installed at that version or newer`);
+			this.clearDeferredExtension(id, version);
+		}
+		// No window yet, so no renderer install in flight: any VSIX not deferred is a leftover.
+		const swept = sweepStagedExtensionDownloads(this.stagingHome, readLocalManifest(this.componentsHome));
+		if (swept.length) {
+			this.logService.info(`[wso2Update] removed unreferenced extension downloads: ${swept.join(', ')}`);
+		}
+		if (!install.length) {
+			return;
+		}
+		// The shared process normally waits for the first window, and the first window is waiting for
+		// this. Only a launch that has something to install starts it early.
+		this.startSharedProcess();
+		for (const { id, version } of install) {
+			try {
+				// Rebuilt from the id and version, not read back from the manifest: a recorded path is
+				// just a string in a JSON file, while these are held to the same shape as at download.
+				const vsix = this.stagedExtensionPath(id, version);
+				this.logService.info(`[wso2Update] installing deferred ${id}@${version} from ${vsix}`);
+				// The options the renderer install uses (see the workbench contribution): a shadow of
+				// the built-in copy, pinned so marketplace auto-update leaves it alone.
+				await this.sharedProcessExtensions.call('install', [URI.file(vsix), { isBuiltin: true, pinned: true }]);
+				await this.recordExtensionInstalled(id, version);
+			} catch (err) {
+				this.logService.warn(`[wso2Update] could not install deferred ${id}@${version}; it will be offered again`, err);
+				this.clearDeferredExtension(id, version);
+			}
+		}
+	}
+
+	/** Forgets a deferred extension and deletes its download. */
+	private clearDeferredExtension(id: string, version: string): void {
+		this.updateLocalManifest(manifest => {
+			const entry = manifest.components[id];
+			if (entry?.deferredExtension?.version === version) {
+				entry.deferredExtension = null;
+			}
+		});
+		this.removeStagedExtension(id, version);
+	}
+
+	private removeStagedExtension(id: string, version: string): void {
+		if (isSafePathSegment(id) && isSafePathSegment(version)) {
+			fs.promises.rm(path.join(this.stagingHome, id, version), { recursive: true, force: true })
+				.catch(err => this.logService.warn(`[wso2Update] could not clean staged ${id}@${version}`, err));
+		}
+	}
+
+	/** Where an extension's VSIX is staged. Throws for an id or version that could leave the staging tree. */
+	private stagedExtensionPath(id: string, version: string): string {
+		// Same trust boundary as stageRuntime: id and version become path segments.
+		if (!isSafePathSegment(id) || !isSafePathSegment(version)) {
+			throw new Error(`Unsafe component id/version: '${id}' '${version}'`);
+		}
+		return path.join(this.stagingHome, id, version, `${id}-${version}.vsix`);
+	}
+
+	private async downloadExtension(component: IWso2ComponentOffer): Promise<string> {
+		const vsixPath = this.stagedExtensionPath(component.id, component.version);
+		await fs.promises.mkdir(path.dirname(vsixPath), { recursive: true });
+		await this.downloadAndVerify(component.artifact.url, vsixPath, {
+			id: component.id,
+			version: component.version,
+			sha256: component.artifact.sha256,
+			requires: component.requires,
+			signature: component.artifact.signature
+		});
+		return vsixPath;
+	}
+
+	private async stageRuntime(component: IWso2ComponentOffer): Promise<void> {
+		// Defense in depth behind resolveOfferedUpdates(): this method removes and renames
+		// directories built from these values, so it re-checks them rather than trusting every
+		// caller to have filtered.
+		if (!isSafePathSegment(component.id) || !isSafePathSegment(component.version)) {
+			throw new Error(`Unsafe component id/version: '${component.id}' '${component.version}'`);
+		}
+		this.logService.info(`[wso2Update] staging runtime ${component.id}@${component.version} from ${component.artifact.url}`);
+		const stagingDir = path.join(this.stagingHome, component.id, component.version);
+		// The archive is kept across attempts: downloadAndVerify() reuses an existing file whose
+		// sha256 already matches, so a failure after the download (extract, rename) retries without
+		// re-fetching hundreds of MB. Only the extracted tree is discarded, below.
+		await fs.promises.mkdir(stagingDir, { recursive: true });
+
+		const archivePath = path.join(stagingDir, `${component.id}-${component.version}.zip`);
+		await this.downloadAndVerify(component.artifact.url, archivePath, {
+			id: component.id,
+			version: component.version,
+			sha256: component.artifact.sha256,
+			requires: component.requires,
+			signature: component.artifact.signature
+		});
+		this.logService.info(`[wso2Update] verified ${component.id}@${component.version}; extracting`);
+		this.lastDownloadActivity = Date.now();
+
+		// A crashed earlier attempt may have left a partial tree here; extracting over it would
+		// merge stale files into the new version. The archive above is the only thing worth reusing.
+		const extractDir = path.join(stagingDir, 'extracted');
+		await fs.promises.rm(extractDir, { recursive: true, force: true });
+		await extract(archivePath, extractDir, {}, CancellationToken.None);
+		this.lastDownloadActivity = Date.now();
+		await fs.promises.rm(archivePath, { force: true });
+
+		// The JRE component is a WRAPPER directory containing a single `jdk-*` home (that is how
+		// it ships bundled and how it is seeded), so keep the extracted tree as-is — do not
+		// descend into the jdk dir. `${COMPONENT:jre}` / WSO2_INTEGRATOR_JRE_DIR then resolve to a
+		// dir the `bal`/`icp` launchers glob as `<dir>/jdk-*`. Other runtimes descend as usual.
+		const runtimeRoot = component.id === 'jre' ? extractDir : this.resolveExtractedRoot(extractDir);
+
+		// Promote atomically into the versioned components directory.
+		const targetDir = path.join(this.componentsHome, component.id, component.version);
+		await fs.promises.rm(targetDir, { recursive: true, force: true });
+		await fs.promises.mkdir(path.dirname(targetDir), { recursive: true });
+		await fs.promises.rename(runtimeRoot, targetDir);
+		// Normalize executable bits — zip archives sometimes drop them, leaving launchers
+		// like bin/bal or the bundled JRE unrunnable ("permission denied").
+		ensureExecutablePermissions(targetDir);
+		await fs.promises.rm(stagingDir, { recursive: true, force: true });
+		this.logService.info(`[wso2Update] staged runtime ${component.id}@${component.version} at ${targetDir} (pending restart)`);
+
+		// Record as pending; activation happens at the next startup (bootstrap).
+		const relPath = path.join('components', component.id, component.version);
+		this.updateLocalManifest(manifest => {
+			const entry = manifest.components[component.id] ?? (manifest.components[component.id] = {});
+			entry.bundledVersion = entry.bundledVersion ?? this.bundledVersion(component.id);
+			// Requirements go with it, so activation can re-check them against whichever app
+			// actually boots next -- not necessarily this one.
+			entry.pending = {
+				version: component.version,
+				path: relPath,
+				installedAt: new Date().toISOString(),
+				healthy: false,
+				...(component.requires ? { requires: component.requires } : {})
+			};
+		});
+
+		// Verify the pending state actually persisted; a silent write failure here would
+		// otherwise show a "restart" prompt while nothing is staged, causing a re-offer loop.
+		const persisted = readLocalManifest(this.componentsHome)?.components[component.id]?.pending?.version;
+		if (persisted !== component.version) {
+			throw new Error(`Failed to persist pending state for ${component.id}@${component.version} at ${getComponentsManifestPath(this.componentsHome)}`);
+		}
+		this.logService.info(`[wso2Update] recorded pending ${component.id}@${component.version} in ${getComponentsManifestPath(this.componentsHome)}`);
+	}
+
+	/** Descends into a single top-level subdirectory when the archive nests the runtime root. */
+	private resolveExtractedRoot(extractDir: string): string {
+		try {
+			const entries = fs.readdirSync(extractDir, { withFileTypes: true });
+			const dirs = entries.filter(e => e.isDirectory());
+			const hasBin = entries.some(e => e.name === 'bin');
+			if (!hasBin && dirs.length === 1 && entries.length === 1) {
+				return path.join(extractDir, dirs[0].name);
+			}
+		} catch {
+			// fall through
+		}
+		return extractDir;
+	}
+
+	private async downloadAndVerify(url: string, destPath: string, expected: IArtifactExpectation): Promise<void> {
+		const expectedSha256 = expected.sha256;
+		if (!this.isAllowedUrl(url)) {
+			throw new Error(`Artifact host not allowed: ${url}`);
+		}
+		// Provenance FIRST, before a byte is fetched. The statement corroborates the digest this
+		// method then enforces, so checking it up front means a relabelled or unsigned artifact
+		// costs one small request instead of a few hundred MB. It also keeps statement failures out
+		// of the download retry loop, where a hiccup fetching a 300-byte file would otherwise
+		// re-download the whole artifact.
+		await this.verifyArtifactStatement(url, expected);
+		// Reuse an already-downloaded file whose contents still match — e.g. from a previous update
+		// attempt — so a re-click doesn't re-fetch hundreds of MB. The sha256 comparison guards
+		// against a truncated or corrupt prior download (mismatch/absent → fall through to download).
+		try {
+			if (await this.sha256OfFile(destPath) === expectedSha256.toLowerCase()) {
+				this.logService.info(`[wso2Update] reusing already-downloaded ${destPath} (sha256 match)`);
+				return;
+			}
+		} catch {
+			// not present or unreadable — download below
+		}
+		for (let attempt = 1; attempt <= DOWNLOAD_ATTEMPTS; attempt++) {
+			try {
+				await this.downloadAttempt(url, destPath, expectedSha256);
+				return;
+			} catch (err) {
+				const retryable = err instanceof DownloadError ? err.retryable : true;
+				if (!retryable || attempt === DOWNLOAD_ATTEMPTS) {
+					throw err;
+				}
+				const delay = DOWNLOAD_RETRY_DELAYS_MS[attempt - 1] ?? DOWNLOAD_RETRY_DELAYS_MS[DOWNLOAD_RETRY_DELAYS_MS.length - 1];
+				this.logService.warn(`[wso2Update] download attempt ${attempt}/${DOWNLOAD_ATTEMPTS} for ${url} failed (${err}); retrying in ${delay}ms`);
+				await new Promise<void>(resolve => setTimeout(resolve, delay));
+			}
+		}
+	}
+
+	/**
+	 * Verifies the artifact's signed STATEMENT — a small JSON document binding id, version and digest
+	 * — against the pinned public key, and checks it agrees with what the manifest claimed.
+	 *
+	 * This is what lets the manifest be treated as untrusted metadata (server-composed, per-client):
+	 * a signature over bytes alone would let a manifest offer an older signed artifact under a newer
+	 * version label, which the client would install, record as current, and then never replace,
+	 * because its version comparison only moves forward. Binding the identity into the signed
+	 * document removes that. `requires` travels inside the statement for the same reason, so
+	 * compatibility constraints cannot be quietly relaxed by whoever composed the manifest.
+	 *
+	 * A declared-but-invalid statement is always fatal. A MISSING one is fatal only under
+	 * wso2UpdateRequireArtifactSignature, since until every artifact is mirrored some manifests
+	 * legitimately reference third-party sources we cannot sign. Nothing here is retryable —
+	 * re-downloading identical bytes cannot change provenance.
+	 */
+	private async verifyArtifactStatement(url: string, expected: IArtifactExpectation): Promise<void> {
+		const publicKey = decodePublicKey(this.productService.wso2UpdatePublicKey);
+		if (!publicKey) {
+			// A build that REQUIRES signatures but cannot produce a usable key is misconfigured
+			// (corrupted pin, bad base64); degrading to sha256-only here would defeat the flag
+			// exactly when it matters. Without the flag, no pinned key means a dev/test build:
+			// sha256 + TLS + host allowlist only.
+			if (this.productService.wso2UpdateRequireArtifactSignature) {
+				throw new DownloadError(`Artifact signatures are required but the pinned public key is missing or unusable`, false);
+			}
+			return;
+		}
+		const signature = expected.signature;
+		if (!signature?.statementUrl || !signature?.sigUrl) {
+			if (this.productService.wso2UpdateRequireArtifactSignature) {
+				throw new DownloadError(`No signed statement for ${url} and artifact signatures are required`, false);
+			}
+			this.logService.info(`[wso2Update] ${url} has no signed statement; verified by sha256 only`);
+			return;
+		}
+		for (const target of [signature.statementUrl, signature.sigUrl]) {
+			if (!this.isAllowedUrl(target)) {
+				throw new DownloadError(`Statement host not allowed: ${target}`, false);
+			}
+		}
+
+		const statementRaw = await this.fetchTextOrThrow(signature.statementUrl, 'wso2Update.artifactStatement');
+		const signatureBase64 = await this.fetchTextOrThrow(signature.sigUrl, 'wso2Update.artifactStatementSignature');
+		if (!verifyDetachedSignature(Buffer.from(statementRaw, 'utf8'), signatureBase64, publicKey)) {
+			throw new DownloadError(`Statement signature verification failed for ${url}`, false);
+		}
+
+		let statement: { id?: string; version?: string; sha256?: string; requires?: { [id: string]: string } };
+		try {
+			statement = JSON.parse(statementRaw);
+		} catch (err) {
+			throw new DownloadError(`Unparseable signed statement for ${url}: ${err}`, false);
+		}
+		// Every field the manifest claimed must match the signed document. sha256 is the link to the
+		// bytes on disk, which downloadAttempt() has already checked against this same value.
+		const mismatch = statement.id !== expected.id ? `id '${statement.id}' != '${expected.id}'`
+			: statement.version !== expected.version ? `version '${statement.version}' != '${expected.version}'`
+				: (statement.sha256 ?? '').toLowerCase() !== expected.sha256.toLowerCase() ? 'sha256 mismatch'
+					: undefined;
+		if (mismatch) {
+			throw new DownloadError(`Signed statement does not match the manifest for ${url}: ${mismatch}`, false);
+		}
+		// A statement that carries requires pins them: the manifest may not widen, narrow or drop them.
+		if (statement.requires && JSON.stringify(sortedEntries(statement.requires)) !== JSON.stringify(sortedEntries(expected.requires ?? {}))) {
+			throw new DownloadError(`Signed statement's requires differ from the manifest for ${url}`, false);
+		}
+		this.logService.info(`[wso2Update] verified signed statement for ${expected.id}@${expected.version}`);
+	}
+
+	/**
+	 * GETs a small text resource (statement / signature) with the same retry policy as an artifact:
+	 * a transient fault fetching a few hundred bytes must not sink an update. Retried here rather
+	 * than by the caller's loop, which would re-download the artifact along with it. A 4xx is not
+	 * retried — the file genuinely is not there.
+	 */
+	private async fetchTextOrThrow(url: string, callSite: string): Promise<string> {
+		for (let attempt = 1; attempt <= DOWNLOAD_ATTEMPTS; attempt++) {
+			try {
+				// followRedirects 0: see fetchUpdates() -- a redirect escapes the host allowlist.
+				const context = await this.requestService.request({ url, headers: this.authHeaders(url), followRedirects: 0, callSite }, CancellationToken.None);
+				const status = context.res.statusCode ?? 0;
+				if (status !== 200) {
+					throw new DownloadError(
+						`Failed to fetch ${url} (HTTP ${status})`,
+						status >= 500 || status === 429 || status === 408
+					);
+				}
+				return (await asText(context)) ?? '';
+			} catch (err) {
+				const retryable = err instanceof DownloadError ? err.retryable : true;
+				if (!retryable || attempt === DOWNLOAD_ATTEMPTS) {
+					throw err instanceof DownloadError ? err : new DownloadError(`Failed to fetch ${url}: ${err}`, false);
+				}
+				const delay = DOWNLOAD_RETRY_DELAYS_MS[attempt - 1] ?? DOWNLOAD_RETRY_DELAYS_MS[DOWNLOAD_RETRY_DELAYS_MS.length - 1];
+				this.logService.warn(`[wso2Update] fetch attempt ${attempt}/${DOWNLOAD_ATTEMPTS} for ${url} failed (${err}); retrying in ${delay}ms`);
+				await new Promise<void>(resolve => setTimeout(resolve, delay));
+			}
+		}
+		throw new DownloadError(`Failed to fetch ${url}`, false); // unreachable: the loop returns or throws
+	}
+
+	/**
+	 * One download attempt. Classifies its failures so downloadAndVerify() knows what to repeat:
+	 * transport faults and 5xx/429/408 are retryable, a 4xx is not (the artifact is not there), and
+	 * neither is a checksum mismatch — that means the manifest and the artifact disagree, so
+	 * re-fetching hundreds of MB would just fail the same way.
+	 */
+	private async downloadAttempt(url: string, destPath: string, expectedSha256: string): Promise<void> {
+		this.logService.info(`[wso2Update] downloading ${url}`);
+		const context = await this.requestService
+			.request({ url, headers: this.authHeaders(url), followRedirects: 0, callSite: 'wso2Update.download' }, CancellationToken.None)
+			.catch(err => {
+				// Never established, so nothing was written: always worth another attempt.
+				throw new DownloadError(`Request failed for ${url}: ${err}`, true);
+			});
+		const status = context.res.statusCode ?? 0;
+		if (status !== 200) {
+			throw new DownloadError(
+				`Unexpected status ${status} downloading ${url}`,
+				status >= 500 || status === 429 || status === 408
+			);
+		}
+		const hash = createHash('sha256');
+		const out = fs.createWriteStream(destPath);
+		await new Promise<void>((resolve, reject) => {
+			// A write can fail asynchronously (disk full, I/O error); surface it so the download
+			// rejects instead of hanging or resolving with a truncated file.
+			out.on('error', err => reject(new DownloadError(`Writing ${destPath} failed: ${err}`, false)));
+			listenStream(context.stream, {
+				onData: chunk => {
+					hash.update(chunk.buffer);
+					if (this.activeDownload) {
+						this.activeDownload.receivedBytes += chunk.buffer.byteLength;
+						this.lastDownloadActivity = Date.now();
+						this.reportProgress();
+					}
+					if (!out.write(chunk.buffer)) {
+						// Honor disk backpressure: pause the network stream until the file
+						// drains, otherwise a slow disk lets a multi-hundred-MB download
+						// queue up in memory.
+						context.stream.pause();
+						out.once('drain', () => context.stream.resume());
+					}
+				},
+				onError: err => {
+					out.destroy();
+					reject(new DownloadError(`Transfer of ${url} failed: ${err}`, true));
+				},
+				onEnd: () => {
+					out.end(() => resolve());
+				}
+			});
+		});
+		const actual = hash.digest('hex').toLowerCase();
+		if (actual !== expectedSha256.toLowerCase()) {
+			await fs.promises.rm(destPath, { force: true });
+			throw new DownloadError(`Checksum mismatch for ${url} (expected ${expectedSha256}, got ${actual})`, false);
+		}
+	}
+
+	/** Streams a file through sha256 (lowercase hex). Rejects if the file is missing/unreadable. */
+	private sha256OfFile(filePath: string): Promise<string> {
+		return new Promise((resolve, reject) => {
+			const hash = createHash('sha256');
+			const stream = fs.createReadStream(filePath);
+			stream.on('error', reject);
+			stream.on('data', chunk => hash.update(chunk));
+			stream.on('end', () => resolve(hash.digest('hex').toLowerCase()));
+		});
+	}
+
+	//#endregion
+
+	//#region status & bookkeeping
+
+	async getComponentStatuses(): Promise<IWso2ComponentStatus[]> {
+		const local = readLocalManifest(this.componentsHome);
+		const bundled = this.productService.bundledComponents ?? {};
+		const statuses = new Map<string, IWso2ComponentStatus>();
+		// A restart of this app leaves these where they are, so "pending restart" would be untrue.
+		const held = local ? heldBackPendingComponents(local, this.appVersion()) : new Map<string, string>();
+		const awaitsApp = (id: string) => held.has(id) || local?.components[id]?.deferredExtension ? { pendingAwaitsAppUpdate: true } : {};
+		const staged = local ? stagedPendingComponents(local, this.appVersion(), this.preparedAppVersion) : new Set<string>();
+		const deferred = local ? awaitingDeferredExtensions(local, this.appVersion(), this.preparedAppVersion) : new Set<string>();
+		const isExtension = (id: string, entry: ILocalComponentEntry) => entry.active?.via === 'user-extension'
+			|| !!entry.deferredExtension
+			|| !!this.productService.builtInExtensions?.some(e => e.name === id);
+
+		// Runtime components known from the bundled set.
+		for (const [id, version] of Object.entries(bundled)) {
+			statuses.set(id, { id, kind: 'runtime', bundledVersion: version, activeVersion: this.activeVersion(id, local), pendingVersion: local?.components[id]?.pending?.version, ...awaitsApp(id), overridden: !!local?.components[id]?.active });
+		}
+		// Anything recorded locally that isn't in the bundled set (e.g. extensions).
+		if (local) {
+			for (const [id, entry] of Object.entries(local.components)) {
+				if (!statuses.has(id)) {
+					statuses.set(id, { id, kind: isExtension(id, entry) ? 'extension' : 'runtime', bundledVersion: entry.bundledVersion, activeVersion: entry.active?.version ?? entry.bundledVersion, pendingVersion: entry.pending?.version ?? entry.deferredExtension?.version, ...awaitsApp(id), overridden: !!entry.active });
+				}
+			}
+		}
+		// Overlay what the server last offered.
+		if (this.lastResponse) {
+			const projected = this.projectedVersions(this.lastResponse);
+			for (const component of this.lastResponse.components) {
+				const existing = statuses.get(component.id);
+				const activeVersion = this.activeVersion(component.id, local);
+				const pendingVersion = local?.components[component.id]?.pending?.version;
+				const deferredVersion = local?.components[component.id]?.deferredExtension?.version;
+				// Not "available" if already current, already staged (pending) at that version,
+				// auto-reverted after a crash loop, or its `requires` are unmet — mirrors
+				// resolveOfferedUpdates so Show Components and the check command agree.
+				const availableVersion = ((!activeVersion || compareVersions(component.version, activeVersion) > 0)
+					&& !(pendingVersion && staged.has(component.id) && compareVersions(pendingVersion, component.version) >= 0)
+					&& !(deferredVersion && deferred.has(component.id) && compareVersions(deferredVersion, component.version) >= 0)
+					&& !local?.components[component.id]?.failed?.some(f => f.version === component.version)
+					&& this.requiresSatisfied(component, local, projected))
+					? component.version : undefined;
+				statuses.set(component.id, {
+					id: component.id,
+					kind: component.kind,
+					bundledVersion: existing?.bundledVersion ?? this.bundledVersion(component.id),
+					activeVersion: existing?.activeVersion ?? activeVersion,
+					availableVersion,
+					pendingVersion: existing?.pendingVersion ?? local?.components[component.id]?.pending?.version ?? local?.components[component.id]?.deferredExtension?.version,
+					...awaitsApp(component.id),
+					overridden: existing?.overridden ?? !!local?.components[component.id]?.active
+				});
+			}
+		}
+		return [...statuses.values()];
+	}
+
+	async stagedExtensionsApplied(): Promise<void> {
+		// Under the same lock as the work that can swap the state out from under it: preparing for an
+		// app update puts its earlier state back when it finishes, and a call that ran in between
+		// would find no Downloaded to clear -- leaving a stale one restored for extensions that are
+		// already installed.
+		return this.runExclusive(async () => {
+			if (this._state.type !== Wso2UpdateStateType.Downloaded) {
+				return;
+			}
+			// A staged runtime only becomes active at the next startup, so the restart affordance has to
+			// survive until then. Extensions are live as soon as the renderer installs them.
+			if (this._state.restartRequired) {
+				return;
+			}
+			// Re-derive rather than assuming Idle: the user may have updated a single component from the
+			// Components picker while others were still on offer.
+			const response = this.lastResponse;
+			const updates = response ? this.resolveOfferedUpdates(response) : [];
+			const appUpdate = response ? this.resolveAppUpdate(response) : undefined;
+			if (updates.length === 0 && !appUpdate) {
+				this.setState({ type: Wso2UpdateStateType.Idle });
+			} else {
+				this.setState({ type: Wso2UpdateStateType.UpdatesAvailable, updates, appUpdate });
+			}
+		});
+	}
+
+	private readonly claimedExtensionInstalls = new Set<string>();
+
+	async claimStagedExtension(id: string, version: string): Promise<boolean> {
+		// Per app run, not persisted: a claim exists to serialize the windows reacting to one
+		// Downloaded event. If the winning install fails, its window reports the failure; a retry
+		// happens through a fresh download, which stages (and claims) anew.
+		const key = `${id}@${version}`;
+		if (this.claimedExtensionInstalls.has(key)) {
+			return false;
+		}
+		this.claimedExtensionInstalls.add(key);
+		return true;
+	}
+
+	async recordExtensionInstalled(id: string, version: string): Promise<void> {
+		let supersededDeferred: string | undefined;
+		this.updateLocalManifest(manifest => {
+			const entry = manifest.components[id] ?? (manifest.components[id] = {});
+			entry.bundledVersion = entry.bundledVersion ?? this.bundledVersion(id);
+			entry.active = { version, via: 'user-extension', installedAt: new Date().toISOString(), healthy: true };
+			// Installed at or past a copy deferred to an app update: that copy has nothing left to do.
+			const deferred = entry.deferredExtension;
+			if (deferred && compareVersions(deferred.version, version) <= 0) {
+				entry.deferredExtension = null;
+				supersededDeferred = deferred.version !== version ? deferred.version : undefined;
+			}
+		});
+		// The staged VSIX has served its purpose; nothing re-reads it, so every kept copy is pure
+		// disk growth (extensions are tens of MB and update often).
+		this.removeStagedExtension(id, version);
+		if (supersededDeferred) {
+			this.removeStagedExtension(id, supersededDeferred);
+		}
+	}
+
+	/**
+	 * We only reach service construction when the app booted successfully, so any override that
+	 * was just activated (marked `healthy: false` by the bootstrap) is now known good — flag it
+	 * healthy and garbage-collect stale versioned directories (keeping active + previous so the
+	 * bootstrap auto-fallback still has a version to roll back to).
+	 */
+	private markHealthyAndGarbageCollect(): void {
+		// App-update leftovers (the MSI, the updater scripts, their logs) are one-shot: applying
+		// quits the app, so anything here at construction belongs to a finished or abandoned
+		// transaction. One MSI per version otherwise accumulates forever.
+		fs.promises.rm(getDownloadsHome(os.homedir(), this.dataFolderName), { recursive: true, force: true })
+			.catch(err => this.logService.warn('[wso2Update] could not clean update downloads', err));
+
+		const manifest = readLocalManifest(this.componentsHome);
+		if (!manifest) {
+			return;
+		}
+		let changed = false;
+		for (const [id, entry] of Object.entries(manifest.components)) {
+			const active = entry.active;
+			if (active && active.path && active.healthy === false) {
+				// App booted successfully with this override → confirm healthy and clear the
+				// auto-fallback boot counter (§D5).
+				entry.active = { ...active, healthy: true, bootCount: undefined };
+				changed = true;
+				this.logService.trace(`[wso2Update] marked ${id}@${active.version} healthy`);
+			}
+			this.garbageCollectComponentVersions(id, entry);
+		}
+		if (changed) {
+			writeLocalManifest(this.componentsHome, manifest);
+		}
+	}
+
+	/** Removes versioned component directories other than the active and previous versions. */
+	private garbageCollectComponentVersions(id: string, entry: ILocalComponentEntry): void {
+		const componentDir = path.join(this.componentsHome, id);
+		let versions: string[];
+		try {
+			versions = fs.readdirSync(componentDir, { withFileTypes: true }).filter(e => e.isDirectory()).map(e => e.name);
+		} catch {
+			return; // no versioned directories (e.g. an extension shadow, installed elsewhere)
+		}
+		// Keep active + previous (for revert) and the bundled-version directory (the first-run
+		// seed baseline, §D8): its `${COMPONENT:*}` fallback target must never be collected, or a
+		// revert-to-bundled after an update would strand the runtime. Key on the product's bundled
+		// version too (not just the recorded entry, which may be unset).
+		// `pending` too: in the narrow window where activation's manifest write failed, the staged
+		// directory is still the next boot's input and must not be collected under it.
+		// Both bundled keys name the DECLARED version. After an editor-only update that directory
+		// does not exist, so neither key protects the seeded tree the runtime actually resolves to
+		// -- and collecting it puts the app straight back to ENOENT on the next boot. Keep whatever
+		// installedComponentVersion() reports whenever the declared version is absent.
+		const declared = this.bundledVersion(id);
+		const seededFallback = installedComponentVersion(this.componentsHome, id, declared, ineligibleBaselineVersions(entry));
+		const keep = new Set([entry.active?.version, entry.previous?.version, entry.pending?.version, entry.bundledVersion, declared, seededFallback].filter((v): v is string => !!v));
+		for (const version of versions) {
+			if (keep.has(version)) {
+				continue;
+			}
+			// A `<version>.seeding-<pid>` staging (or `.repair-<pid>` claim) directory owned by a
+			// live process is a second instance's copy in flight (seeding runs before the
+			// single-instance lock). Deleting it mid-copy re-opens the partial-seed race; stale
+			// or aged ones are collected as usual.
+			if (isActiveSeedingDir(componentDir, version)) {
+				continue;
+			}
+			try {
+				fs.rmSync(path.join(componentDir, version), { recursive: true, force: true });
+				this.logService.info(`[wso2Update] GC removed ${id}@${version}`);
+			} catch (err) {
+				this.logService.warn(`[wso2Update] GC failed for ${id}@${version}`, err);
+			}
+		}
+	}
+
+	async downloadAppInstaller(): Promise<void> {
+		const appUpdate = this._state.type === Wso2UpdateStateType.UpdatesAvailable ? this._state.appUpdate : undefined;
+		const url = appUpdate?.installerUrl ?? this.lastResponse?.app?.installer.url;
+		if (!url) {
+			return;
+		}
+		if (!this.isAllowedUrl(url)) {
+			this.logService.warn(`[wso2Update] refusing to open non-allowlisted installer URL: ${url}`);
+			return;
+		}
+		await shell.openExternal(url);
+	}
+
+	async applyAppUpdate(): Promise<void> {
+		// Only Windows supports a silent in-place upgrade here; macOS uses Squirrel.Mac and
+		// Linux uses the notify+download flow. Fall back for those platforms.
+		if (process.platform !== 'win32') {
+			return this.downloadAppInstaller();
+		}
+		return this.runExclusive(() => this.doApplyAppUpdate());
+	}
+
+	private async doApplyAppUpdate(): Promise<void> {
+		const app = this.lastResponse?.app;
+		if (!app) {
+			return;
+		}
+		const { url, sha256, signature } = app.installer;
+		if (!this.isAllowedUrl(url)) {
+			this.logService.warn(`[wso2Update] refusing non-allowlisted app installer URL: ${url}`);
+			throw new Error(`App installer host not allowed: ${url}`);
+		}
+		// Defense in depth: the version comes from the (signature-verified) manifest, but it is
+		// interpolated into a file path and a cmd.exe command line below — reject anything that
+		// isn't a plain version string so shell metacharacters can never reach the command.
+		if (!/^[0-9A-Za-z.+_-]+$/.test(app.version)) {
+			throw new Error(`Refusing to apply app update with unexpected version string: ${app.version}`);
+		}
+
+		// Download and verify the editor-only update MSI (sha256 from the signed manifest is the
+		// integrity chain, matching the component download path) before executing anything.
+		const downloadsHome = getDownloadsHome(os.homedir(), this.dataFolderName);
+		await fs.promises.mkdir(downloadsHome, { recursive: true });
+		const msiPath = path.join(downloadsHome, `wso2-integrator-${app.version}-update.msi`);
+		this.logService.info(`[wso2Update] downloading app update ${app.version} MSI`);
+		// `app` is the reserved statement id for the core-app installer.
+		await this.downloadAndVerify(url, msiPath, { id: 'app', version: app.version, sha256, signature });
+		this.logService.info(`[wso2Update] verified app update MSI at ${msiPath}; scheduling silent install on quit`);
+
+		// The MSI is editor-only, so fetch the runtimes this version needs before quitting to install
+		// it. Best effort, with the same stall guard as macOS: a download that stops moving must not
+		// keep "Update and Restart" from ever installing. Whatever is missing, the new app is offered
+		// on its own first check.
+		const incoming = incomingAppVersionToPrepare(app.version, this.appVersion());
+		if (incoming) {
+			await this.untilPreparedOrStalled(this.stageComponentsForAppUpdate(incoming), incoming);
+		}
+
+		// Apply the editor-only MSI on quit, then relaunch — deterministically. The earlier approach
+		// (a detached cmd.exe with fixed `ping` delays) was racy: msiexec could fire while the app
+		// still held locks, leaving the update unapplied, and Node's windowsHide+detached combo
+		// intermittently flashed a console window. Instead write a small updater batch that WAITS for
+		// this process to actually exit (rather than guessing a delay), retries msiexec with a
+		// verbose log + a status file (so any failure is diagnosable under the downloads folder),
+		// then relaunches — and start it fully hidden via a tiny VBScript shim (WScript.Shell.Run
+		// with windowStyle 0 reliably suppresses the console, unlike windowsHide on a detached cmd).
+		// (`ping` provides the sub-second waits because `timeout` needs a console the hidden process
+		// lacks.)
+		const exe = process.execPath;
+		const pid = process.pid;
+		const msiLogPath = path.join(downloadsHome, 'apply-update.msiexec.log');
+		const statusPath = path.join(downloadsHome, 'apply-update.status');
+		const batPath = path.join(downloadsHome, 'apply-update.bat');
+		const vbsPath = path.join(downloadsHome, 'apply-update.launch.vbs');
+		const splashPath = path.join(downloadsHome, 'apply-update.splash.hta');
+
+		const bat = [
+			'@echo off',
+			'setlocal enabledelayedexpansion',
+			// Resolve every system utility from System32 by absolute path — never via PATH lookup,
+			// which a user-writable PATH entry could shadow (defense in depth; no elevation involved).
+			'set "SYS=%SystemRoot%\\System32"',
+			// Reset the status file up front so the splash (launched next) never sees a stale "done"
+			// left by a prior update run and close immediately.
+			`echo start %date% %time% pid=${pid} > "${statusPath}"`,
+			// Show a small progress window for the multi-minute install (the app window is gone by
+			// now, so without this the screen looks frozen). mshta renders the .hta with a normal GUI
+			// window even though this cmd is hidden; the .hta polls the status file and closes itself
+			// once we write "done" just before relaunch.
+			`start "" "%SYS%\\mshta.exe" "${splashPath}"`,
+			// Wait for the editor (this PID) to fully exit so its install files are unlocked. The
+			// wait is bounded (~10 min): if quit was vetoed (an unsaved-file dialog, say), the app
+			// may keep running indefinitely, and an updater still armed hours later would fire
+			// msiexec against a state nobody remembers scheduling. Giving up is recoverable -- the
+			// update is simply offered again -- an untimely install is not.
+			'set WAITED=0',
+			':waitloop',
+			`"%SYS%\\tasklist.exe" /fi "PID eq ${pid}" 2>nul | "%SYS%\\find.exe" "${pid}" >nul`,
+			'if not errorlevel 1 (',
+			'  set /a WAITED+=1',
+			'  if %WAITED% geq 600 (',
+			`    echo done rc=timeout waiting for pid ${pid} %time% >> "${statusPath}"`,
+			'    exit /b 1',
+			'  )',
+			'  "%SYS%\\ping.exe" -n 2 127.0.0.1 >nul',
+			'  goto waitloop',
+			')',
+			// Settle so child processes (extension host, pty host) release their locks too.
+			'"%SYS%\\ping.exe" -n 3 127.0.0.1 >nul',
+			// Install silently (no UAC for a per-user MSI). msiexec bails immediately with 1618
+			// (ERROR_INSTALL_ALREADY_RUNNING) if any other Windows Installer transaction holds the
+			// global execute mutex — which happens transiently right after the base install or when
+			// another installer is mid-flight. A few quick retries are not enough to outlast it, so
+			// retry patiently (up to ~5 min) until msiexec succeeds; break out on success (0) or a
+			// reboot-pending success (3010/1641).
+			'set /a tries=0',
+			':retry',
+			'set /a tries+=1',
+			`"%SYS%\\msiexec.exe" /i "${msiPath}" /qn /norestart /l*v "${msiLogPath}"`,
+			'set RC=!errorlevel!',
+			`echo attempt !tries! rc=!RC! %time% >> "${statusPath}"`,
+			'if "!RC!"=="0" goto relaunch',
+			'if "!RC!"=="3010" goto relaunch',
+			'if "!RC!"=="1641" goto relaunch',
+			'if !tries! geq 40 goto relaunch',
+			'"%SYS%\\ping.exe" -n 8 127.0.0.1 >nul',
+			'goto retry',
+			':relaunch',
+			// Settle so the freshly-written exe is unlocked, THEN mark done (closes the splash) and
+			// relaunch — so the splash stays up until the moment the editor reappears.
+			'"%SYS%\\ping.exe" -n 4 127.0.0.1 >nul',
+			`echo done rc=!RC! tries=!tries! %time% >> "${statusPath}"`,
+			`start "" "${exe}"`,
+			''
+		].join('\r\n');
+
+		// VBScript shim: run the batch with a hidden window (0) without waiting (False). The doubled
+		// quotes each escape a literal quote inside the VBScript string literal. ComSpec is expanded
+		// by WScript itself (absolute cmd.exe, not a PATH lookup).
+		const vbs = [
+			'Set sh = CreateObject("WScript.Shell")',
+			`sh.Run sh.ExpandEnvironmentStrings("%ComSpec%") & " /c ""${batPath}""", 0, False`,
+			''
+		].join('\r\n');
+
+		// Progress splash (borderless HTA rendered by the built-in mshta). It polls the status file
+		// via FileSystemObject and closes itself when the batch writes "done" (or after a 10-min
+		// safety timeout). statusPath is embedded as a JSON string literal so backslashes are escaped.
+		const splash = [
+			'<!DOCTYPE html>',
+			'<html>',
+			'<head>',
+			'<meta http-equiv="x-ua-compatible" content="ie=edge" />',
+			'<title>WSO2 Integrator Update</title>',
+			'<hta:application id="app" border="none" caption="no" showintaskbar="yes" sysmenu="no" maximizebutton="no" minimizebutton="no" scroll="no" singleinstance="yes" innerborder="no" contextmenu="no" selection="no" />',
+			'<style>',
+			`html,body{margin:0;height:100%;font-family:'Segoe UI',Tahoma,sans-serif;background:#1b1b1f;color:#e8e8ea;overflow:hidden;}`,
+			'.wrap{box-sizing:border-box;height:100%;padding:24px 30px;display:flex;flex-direction:column;justify-content:center;border:1px solid #3a3a40;}',
+			'.title{font-size:16px;font-weight:600;margin:0 0 8px;}',
+			'.sub{font-size:12px;line-height:1.5;color:#a9a9b2;margin:0 0 18px;}',
+			'.bar{position:relative;height:6px;border-radius:3px;background:#2c2c33;overflow:hidden;}',
+			'.fill{position:absolute;top:0;left:-40%;width:40%;height:100%;border-radius:3px;background:#ff7300;animation:slide 1.2s ease-in-out infinite;}',
+			'@keyframes slide{0%{left:-40%}100%{left:100%}}',
+			'</style>',
+			'</head>',
+			'<body>',
+			'<div class="wrap">',
+			'<p class="title">Updating WSO2 Integrator&hellip;</p>',
+			'<p class="sub">This may take a few minutes. The editor will reopen automatically when the update is complete.</p>',
+			'<div class="bar"><div class="fill"></div></div>',
+			'</div>',
+			'<script language="javascript">',
+			'window.resizeTo(460,180);',
+			'try{window.moveTo(Math.max(0,(screen.availWidth-460)/2),Math.max(0,(screen.availHeight-180)/2));}catch(e){}',
+			'var fso=new ActiveXObject("Scripting.FileSystemObject");',
+			`var statusFile=${JSON.stringify(statusPath)};`,
+			'var started=(new Date()).getTime();',
+			'function tick(){',
+			'  try{',
+			'    if(fso.FileExists(statusFile)){',
+			'      var f=fso.OpenTextFile(statusFile,1,false);var t=f.ReadAll();f.Close();',
+			'      if(t.indexOf("done rc=")>=0){window.close();return;}',
+			'    }',
+			'  }catch(e){}',
+			'  if((new Date()).getTime()-started>600000){window.close();return;}',
+			'  window.setTimeout(tick,1000);',
+			'}',
+			'window.setTimeout(tick,1000);',
+			'</script>',
+			'</body>',
+			'</html>',
+			''
+		].join('\r\n');
+
+		await fs.promises.writeFile(batPath, bat, 'utf8');
+		await fs.promises.writeFile(vbsPath, vbs, 'utf8');
+		await fs.promises.writeFile(splashPath, splash, 'utf8');
+		this.logService.info(`[wso2Update] launching hidden updater (waits for pid ${pid} to exit); msiexec log -> ${msiLogPath}, status -> ${statusPath}`);
+		const systemRoot = process.env['SystemRoot'] || 'C:\\Windows';
+		const child = spawn(path.join(systemRoot, 'System32', 'wscript.exe'), [vbsPath], {
+			detached: true,
+			stdio: 'ignore',
+			windowsHide: true
+		});
+		child.unref();
+
+		this.lifecycleMainService.quit();
+	}
+
+	private persistCheckMetadata(response: IWso2UpdateCheckResponse): void {
+		this.updateLocalManifest(local => {
+			local.channel = this.channel;
+			local.lastCheck = new Date().toISOString();
+			if (typeof response.sequence === 'number') {
+				local.lastManifestSequence = response.sequence;
+			}
+		});
+	}
+
+	private updateLocalManifest(mutate: (manifest: ILocalComponentsManifest) => void): void {
+		try {
+			const manifest = readLocalManifest(this.componentsHome) ?? {
+				schemaVersion: LOCAL_MANIFEST_SCHEMA_VERSION,
+				bundledAppVersion: this.appVersion(),
+				components: {}
+			};
+			manifest.bundledAppVersion = this.appVersion();
+			mutate(manifest);
+			writeLocalManifest(this.componentsHome, manifest);
+		} catch (err) {
+			this.logService.warn('[wso2Update] failed to persist local manifest', err);
+		}
+	}
+
+	//#endregion
+
+	//#region helpers
+
+	private activeVersion(id: string, local: ILocalComponentsManifest | undefined): string | undefined {
+		const active = local?.components[id]?.active?.version;
+		if (active) {
+			return active;
+		}
+		// Report what is on disk, not what product.json claims to bundle. Those agree for an app
+		// installed from the full installer, and diverge after an editor-only update: the new
+		// product.json names runtimes the payload never carried, so falling back to the declared
+		// version makes the client tell the server it already HAS the version it is missing. The
+		// server then correctly offers nothing and the state can never heal itself -- which is
+		// exactly how a stranded ballerina-runtime stayed stranded across every hourly check.
+		// Returns undefined when nothing is on disk, so callers must not paper over that with the
+		// declared version: an honest gap is what lets the server offer the component.
+		const bundled = this.bundledVersion(id);
+		if (bundled && this.productService.bundledComponents?.[id]) {
+			return installedComponentVersion(this.componentsHome, id, bundled, ineligibleBaselineVersions(local?.components[id]));
+		}
+		return bundled;
+	}
+
+	private bundledVersion(id: string): string | undefined {
+		// Runtime components (ballerina-runtime / jre / icp) come from bundledComponents;
+		// extension components' bundled versions live in builtInExtensions.
+		const runtime = this.productService.bundledComponents?.[id];
+		if (runtime) {
+			return runtime;
+		}
+		return this.productService.builtInExtensions?.find(e => e.name === id)?.version;
+	}
+
+	private appVersion(): string {
+		return this.productService.wiversion ?? this.productService.version;
+	}
+
+	/** Cached device id; see deviceId(). Never transmitted — only its 0-99 bucket is. */
+	private _deviceId: string | undefined;
+
+	private deviceId(): string {
+		if (this._deviceId) {
+			return this._deviceId;
+		}
+		const existing = readLocalManifest(this.componentsHome)?.deviceId;
+		if (existing) {
+			this._deviceId = existing;
+			return existing;
+		}
+		// Generate a stable, never-transmitted id used only for local rollout bucketing.
+		const id = createHash('sha1').update(`${os.hostname()}:${os.homedir()}:${Date.now()}`).digest('hex');
+		this._deviceId = id;
+		this.updateLocalManifest(manifest => { manifest.deviceId = id; });
+		return id;
+	}
+
+	private platformKey(): string {
+		return process.platform; // 'darwin' | 'linux' | 'win32'
+	}
+
+	private archKey(): string {
+		return process.arch === 'arm64' ? 'arm64' : 'x64';
+	}
+
+	private static isLoopbackHost(host: string): boolean {
+		return host === 'localhost' || host === '127.0.0.1' || host === '::1' || host === '[::1]';
+	}
+
+	private isAllowedUrl(url: string): boolean {
+		try {
+			const parsed = new URL(url);
+			const host = parsed.hostname.toLowerCase();
+			const configuredHost = this.updateBaseUrl ? new URL(this.updateBaseUrl).hostname.toLowerCase() : undefined;
+
+			// Plain-http loopback is for local update-server development, so it is allowed only when
+			// the configured update server is itself loopback. A production build points at the real
+			// server and refuses it.
+			const isLoopback = Wso2ComponentUpdateService.isLoopbackHost(host);
+			const developingAgainstLocalServer = !!configuredHost && Wso2ComponentUpdateService.isLoopbackHost(configuredHost);
+			if (isLoopback) {
+				return developingAgainstLocalServer && (parsed.protocol === 'http:' || parsed.protocol === 'https:');
+			}
+			if (parsed.protocol !== 'https:') {
+				return false;
+			}
+			if (configuredHost && host === configuredHost) {
+				return true;
+			}
+			return ALLOWED_HOST_SUFFIXES.some(suffix => host === suffix || host.endsWith(`.${suffix}`));
+		} catch {
+			return false;
+		}
+	}
+
+	//#endregion
+}
