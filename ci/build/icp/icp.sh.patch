@@ -1,2 +1,13 @@
 #!/bin/bash
+WSO2_ICP_JAVA=""
+_wso2_icp_sd="$(cd "$(dirname "$0")" && pwd)"
+if [ -n "$WSO2_INTEGRATOR_JRE_HOME" ] && [ -x "$WSO2_INTEGRATOR_JRE_HOME/bin/java" ]; then
+  WSO2_ICP_JAVA="$WSO2_INTEGRATOR_JRE_HOME/bin/java"
+else
+  WSO2_ICP_JAVA="$_wso2_icp_sd/../../dependencies/jdk-*/bin/java"
