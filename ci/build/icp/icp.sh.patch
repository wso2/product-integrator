--- a/bin/icp.sh
+++ b/bin/icp.sh
@@ -29,6 +29,20 @@
 LOG_DIR="$PARENT_DIR/logs"
 LOG_FILE="$LOG_DIR/icp.log"
 TMP_DIR="$PARENT_DIR/tmp"
+
+# WSO2 Integrator: run on our JRE, the active one (WSO2_INTEGRATOR_JRE_HOME) or the one shipped next
+# to ICP (../../dependencies), falling back to java on PATH.
+WSO2_ICP_JAVA=java
+if [ -n "$WSO2_INTEGRATOR_JRE_HOME" ] && [ -x "$WSO2_INTEGRATOR_JRE_HOME/bin/java" ]; then
+    WSO2_ICP_JAVA="$WSO2_INTEGRATOR_JRE_HOME/bin/java"
+else
+    for jdk in "$SCRIPT_DIR"/../../dependencies/jdk-*; do
+        if [ -x "$jdk/bin/java" ]; then
+            WSO2_ICP_JAVA="$jdk/bin/java"
+            break
+        fi
+    done
+fi
 
 resolve_version() {
     if [ -f "$PARENT_DIR/version.txt" ]; then
@@ -158,13 +172,13 @@
     fi
 
