# Environment Configuration (optional)
# Copy this file to .env and configure as needed

# Extension Development
# Set to 'development' for verbose logging
NODE_ENV=production

# Feature Flags
# Enable experimental features
ENABLE_EXPERIMENTAL_FEATURES=false

# Webview Development
# Use local webview server for hot reload (development only)
USE_LOCAL_WEBVIEW=false
WEBVIEW_DEV_SERVER=http://localhost:3000
MI_SAMPLE_ICONS_GITHUB_URL=https://raw.githubusercontent.com/wso2/integration-studio/main/SamplesForVSCode/icons/
BI_SAMPLE_ICONS_GITHUB_URL=https://devant-cdn.wso2.com/bi-samples/v1/images-new/
SAMPLES_INFO_URL=https://raw.githubusercontent.com/wso2/integration-samples/main/.metadata/samples.json
SAMPLES_REPOSITORY_URL=https://github.com/wso2/integration-samples/
PREBUILT_INTEGRATIONS_URL=https://raw.githubusercontent.com/wso2/integration-samples/main/.metadata/prebuilt-integrations.json

# Copilot backends, one per WSO2 Cloud environment. The Copilot token exchange
# sends the WSO2 Cloud token only to these, read at build time; the Ballerina
# extension must name the same ones. The production regions' are public and
# set here; dev's comes from the build's environment (CI: a secret), which
# also overrides any of these. An environment with none has no exchange.
COPILOT_ROOT_URL=https://apis.devant.dev/copilot
COPILOT_EU_ROOT_URL=https://366b8031-ab7f-4a98-a1bd-3369fbd00eee-prod.e1-eu-west-cdp.choreoapis.dev/copilot
# COPILOT_STAGE_ROOT_URL=
# COPILOT_DEV_ROOT_URL=
