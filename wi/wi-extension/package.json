{
  "name": "wso2-integrator",
  "displayName": "Choreo Integrator",
  "description": "Integration development environment for Choreo Integrator",
  "version": "1.2.0",
  "publisher": "wso2",
  "icon": "resources/icons/wso2-integrator-logo.png",
  "license": "Apache-2.0",
  "repository": {
    "url": "https://github.com/wso2/product-integrator"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri",
    "onCommand:wso2.integrator.getEmbeddedWelcomeBootstrap",
    "workspaceContains:**/Ballerina.toml",
    "onLanguage:SynapseXml",
    "onLanguage:ballerina",
    "workspaceContains:.project",
    "workspaceContains:pom.xml",
    "workspaceContains:**/*.siddhi"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "authentication": [
      {
        "id": "wso2-cloud",
        "label": "Choreo Cloud"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Choreo Integrator",
      "properties": {
        "integrator.selectedProfile": {
          "type": "string",
          "enum": [
            "Choreo Integrator: Default",
            "Choreo Integrator: MI",
            "Choreo Integrator: SI"
          ],
          "default": "Choreo Integrator: Default",
          "description": "Select the active Choreo Integrator profile."
        },
        "integrator.advanced.cloudEnv": {
          "type": "string",
          "enum": [
            "prod",
            "stage",
            "dev"
          ],
          "enumDescriptions": [
            "Production. Select the region (United States or Europe) when signing in.",
            "Staging",
            "Development"
          ],
          "default": "prod",
          "description": "The Choreo Cloud environment to use.",
          "scope": "machine"
        },
        "integrator.advanced.cloudClientId": {
          "type": "string",
          "default": "",
          "markdownDescription": "Overrides the OAuth client id used to sign in to Choreo Cloud. Leave empty unless the Choreo Cloud team told you to set it.",
          "scope": "machine"
        },
        "integrator.advanced.cloudApiBaseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Overrides the Choreo Cloud API base URL. Leave empty unless the Choreo Cloud team told you to set it.",
          "scope": "machine"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wso2-integrator",
          "title": "Choreo Integrator",
          "icon": "resources/icons/integrator-activity-icon.svg"
        },
        {
          "id": "wso2-agent-builder",
          "title": "Choreo Agent Builder",
          "icon": "resources/icons/integrator-activity-icon.svg"
        }
      ]
    },
    "views": {
      "wso2-integrator": [
        {
          "id": "wso2-integrator.explorer",
          "name": "Integrations",
          "contextualTitle": "Choreo Integrator",
          "when": "WI.productMode != 'agent-builder' && (!WI.projectType || (WI.projectType != 'si' && WI.projectType != 'mi'))"
        }
      ],
      "wso2-agent-builder": [
        {
          "id": "wso2-agent-builder.explorer",
          "name": "Agents",
          "contextualTitle": "Choreo Agent Builder",
          "when": "WI.productMode == 'agent-builder' && (!WI.projectType || (WI.projectType != 'si' && WI.projectType != 'mi'))"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "wso2-integrator.explorer",
        "contents": "$(loadingspin) Loading Choreo Integrator...",
        "when": "WI.productMode != 'agent-builder' && !WI.projectType && BI.status != 'updateNeed' && BI.status != 'noLS'"
      },
      {
        "view": "wso2-agent-builder.explorer",
        "contents": "$(loadingspin) Loading Choreo Agent Builder...",
        "when": "WI.productMode == 'agent-builder' && !WI.projectType && BI.status != 'updateNeed' && BI.status != 'noLS'"
      },
      {
        "view": "wso2-integrator.explorer",
        "contents": "$(rocket) Build integration solutions with Choreo Integrator.\n\nUse the welcome page to create a new project, explore samples, import external integrations, and manage profile settings.\n\nOpen an integration project folder to see your artifacts in this panel.\n\n[Get Started](command:wso2.integrator.openWelcome)",
        "when": "WI.productMode != 'agent-builder' && WI.projectType == 'none'"
      },
      {
        "view": "wso2-agent-builder.explorer",
        "contents": "$(rocket) Build AI agents with Choreo Agent Builder.\n\nUse the welcome page to create a new agent project or explore samples.\n\nOpen an agent project folder to see your artifacts in this panel.\n\n[Get Started](command:wso2.integrator.openWelcome)",
        "when": "WI.productMode == 'agent-builder' && WI.projectType == 'none'"
      },
      {
        "view": "wso2-integrator.explorer",
        "contents": "No integrations or libraries found in this project.\n\nGet started by adding your first integration or library.\n\n[$(add) Add Integration or Library](command:BI.project-explorer.add)",
        "when": "BI.project.empty"
      },
      {
        "view": "wso2-agent-builder.explorer",
        "contents": "No integrations or libraries found in this project.\n\nGet started by adding your first integration or library.\n\n[$(add) Add Integration or Library](command:BI.project-explorer.add)",
        "when": "BI.project.empty"
      },
      {
        "view": "wso2-integrator.explorer",
        "contents": "Welcome to Choreo Integrator.\n\nYour current Ballerina distribution is not supported. Please update to version 2201.12.3 or above to continue.\n\n[Update Ballerina](command:wso2.integrator.setupBallerinaVisually)\n\nAfter updating, restart the editor to apply the changes. [Learn more](https://choreolabs.com/integration-platform/docs/)",
        "when": "WI.productMode != 'agent-builder' && (!WI.projectType || (WI.projectType != 'si' && WI.projectType != 'mi' && WI.projectType != 'none')) && BI.status == 'updateNeed'"
      },
      {
        "view": "wso2-agent-builder.explorer",
        "contents": "Welcome to Choreo Agent Builder.\n\nYour current Ballerina distribution is not supported. Please update to version 2201.12.3 or above to continue.\n\n[Update Ballerina](command:wso2.integrator.setupBallerinaVisually)\n\nAfter updating, restart the editor to apply the changes. [Learn more](https://choreolabs.com/integration-platform/docs/)",
        "when": "WI.productMode == 'agent-builder' && (!WI.projectType || (WI.projectType != 'si' && WI.projectType != 'mi' && WI.projectType != 'none')) && BI.status == 'updateNeed'"
      },
      {
        "view": "wso2-integrator.explorer",
        "contents": "Welcome to Choreo Integrator.\n\nA Ballerina distribution is required but was not found on this machine. Please set up Ballerina to get started.\n\n[Set Up Ballerina](command:wso2.integrator.setupBallerinaVisually)\n\nAfter installation, restart the editor to apply the changes. [Learn more](https://choreolabs.com/integration-platform/docs/)",
        "when": "WI.productMode != 'agent-builder' && (!WI.projectType || (WI.projectType != 'si' && WI.projectType != 'mi' && WI.projectType != 'none')) && BI.status == 'noLS'"
      },
      {
        "view": "wso2-agent-builder.explorer",
        "contents": "Welcome to Choreo Agent Builder.\n\nA Ballerina distribution is required but was not found on this machine. Please set up Ballerina to get started.\n\n[Set Up Ballerina](command:wso2.integrator.setupBallerinaVisually)\n\nAfter installation, restart the editor to apply the changes. [Learn more](https://choreolabs.com/integration-platform/docs/)",
        "when": "WI.productMode == 'agent-builder' && (!WI.projectType || (WI.projectType != 'si' && WI.projectType != 'mi' && WI.projectType != 'none')) && BI.status == 'noLS'"
      }
    ],
    "commands": [
      {
        "command": "wso2.integrator.openWelcome",
        "title": "Open Welcome Page",
        "category": "Choreo Integrator",
        "icon": "$(home)"
      },
      {
        "command": "wso2-integrator.explorer.refresh",
        "title": "Refresh",
        "category": "Choreo Integrator",
        "icon": "$(refresh)"
      },
      {
        "command": "wso2.integrator.openBIIntegration",
        "title": "Open Default Integration",
        "category": "Choreo Integrator"
      },
      {
        "command": "wso2.integrator.openMIIntegration",
        "title": "Open MI Integration",
        "category": "Choreo Integrator"
      },
      {
        "command": "wso2.integrator.cloud.auth.signIn",
        "title": "Sign In",
        "category": "Choreo Integrator",
        "icon": "$(sign-in)",
        "enablement": "!isLoggedIn"
      },
      {
        "command": "wso2.integrator.cloud.auth.signOut",
        "title": "Sign Out",
        "category": "Choreo Integrator",
        "icon": "$(sign-out)",
        "enablement": "isLoggedIn"
      },
      {
        "command": "wso2.integrator.cloud.auth.cancelSignIn",
        "title": "Cancel Sign In",
        "category": "Choreo Integrator"
      },
      {
        "command": "wso2.integrator.cloud.auth.switchRegion",
        "title": "Switch Choreo Cloud Region",
        "category": "WSO2 Integrator",
        "icon": "$(globe)",
        "enablement": "wso2.integrator.cloud.multiRegion"
      },
      {
        "command": "wso2.integrator.cloud.integration.create",
        "title": "Create Integration in Choreo Cloud",
        "category": "Choreo Integrator",
        "icon": "$(add)"
      },
      {
        "command": "wso2.integrator.cloud.integration.delete",
        "title": "Delete Integration from Cloud",
        "category": "Choreo Integrator",
        "icon": "$(trash)"
      },
      {
        "command": "wso2.integrator.cloud.integration.openInConsole",
        "title": "Open in Cloud Console",
        "category": "Choreo Integrator",
        "icon": "$(link-external)"
      },
      {
        "command": "wso2.integrator.cloud.project.clone",
        "title": "Clone Cloud Project Repository",
        "category": "Choreo Integrator",
        "icon": "$(repo-clone)"
      },
      {
        "command": "wso2.integrator.cloud.project.createContext",
        "title": "Associate Cloud Project",
        "category": "Choreo Integrator",
        "icon": "$(link)"
      },
      {
        "command": "wso2.integrator.cloud.project.manageContext",
        "title": "Manage Cloud Project",
        "category": "Choreo Integrator",
        "icon": "$(settings-gear)"
      },
      {
        "command": "wso2.integrator.cloud.project.refresh",
        "title": "Refresh Workspace",
        "category": "Choreo Integrator",
        "icon": "$(refresh)",
        "enablement": "!isLoadingContextDirs"
      },
      {
        "command": "ballerina.showVisualizer",
        "title": "Show Visualizer",
        "icon": {
          "light": "resources/icons/preview-command-icon.svg",
          "dark": "resources/icons/preview-command-icon-dark.svg"
        },
        "category": "Choreo Integrator"
      },
      {
        "command": "ballerina.force.update.artifacts",
        "title": "Force Update Artifacts",
        "icon": "$(refresh)",
        "category": "Choreo Integrator"
      },
      {
        "command": "BI.project-explorer.add",
        "title": "Add Integration or Library",
        "icon": "$(add)",
        "category": "Choreo Integrator"
      },
      {
        "command": "BI.project-explorer.convert",
        "title": "Convert to Project",
        "icon": "$(package)",
        "category": "Choreo Integrator"
      },
      {
        "command": "BI.project-explorer.open-project",
        "title": "Open Project",
        "icon": "$(folder-opened)",
        "category": "Choreo Integrator"
      },
      {
        "command": "BI.project-explorer.add-to-project",
        "title": "Add to Project",
        "icon": "$(add)",
        "category": "Choreo Integrator"
      },
      {
        "command": "BI.project-explorer.overview",
        "title": "Open Overview",
        "icon": {
          "light": "resources/icons/preview-command-icon.svg",
          "dark": "resources/icons/preview-command-icon-dark.svg"
        },
        "category": "Choreo Integrator"
      },
      {
        "command": "BI.project-explorer.add-connection",
        "title": "Add Connection",
        "icon": "$(add)",
        "category": "Choreo Integrator"
      },
      {
        "command": "BI.project-explorer.add-agent",
        "title": "Add Agent",
        "icon": "$(add)",
        "category": "Choreo Integrator"
      },
      {
        "command": "BI.project-explorer.add-agent-definition",
        "title": "Add Agent Definition",
        "icon": "$(add)",
        "category": "Choreo Integrator"
      },
      {
        "command": "BI.project-explorer.add-agent-tool",
        "title": "Add Agent Tool",
        "icon": "$(add)",
        "category": "Choreo Integrator"
      },
      {
        "command": "BI.project-explorer.add-model-provider",
        "title": "Add Model Provider",
        "icon": "$(add)",
        "category": "Choreo Integrator"
      },
      {
        "command": "BI.project-explorer.delete",
        "title": "Delete",
        "icon": "$(trash)",
        "category": "Choreo Integrator"
      },
      {
        "command": "BI.project-explorer.add-entry-point",
        "title": "Add Entry Point",
        "icon": "$(add)",
        "category": "Choreo Integrator"
      },
      {
        "command": "BI.project-explorer.add-type",
        "title": "Add Type",
        "icon": "$(add)",
        "category": "Choreo Integrator"
      },
      {
        "command": "BI.project-explorer.view-type-diagram",
        "title": "View Type Diagram",
        "icon": {
          "light": "resources/icons/preview-command-icon.svg",
          "dark": "resources/icons/preview-command-icon-dark.svg"
        },
        "category": "Choreo Integrator"
      },
      {
        "command": "BI.project-explorer.add-function",
        "title": "Add Function",
        "icon": "$(add)",
        "category": "Choreo Integrator"
      },
      {
        "command": "BI.project-explorer.add-configuration",
        "title": "Add Configuration",
        "icon": "$(add)",
        "category": "Choreo Integrator"
      },
      {
        "command": "BI.project-explorer.view-configuration",
        "title": "View Configuration",
        "icon": {
          "light": "resources/icons/preview-command-icon.svg",
          "dark": "resources/icons/preview-command-icon-dark.svg"
        },
        "category": "Choreo Integrator"
      },
      {
        "command": "BI.project-explorer.add-data-mapper",
        "title": "Add Data Mapper",
        "icon": "$(add)",
        "category": "Choreo Integrator"
      },
      {
        "command": "BI.project-explorer.add-natural-function",
        "title": "Add Natural Function",
        "icon": "$(add)",
        "category": "Choreo Integrator"
      },
      {
        "command": "BI.project-explorer.add-custom-connector",
        "title": "Add Custom Connector",
        "icon": "$(add)",
        "category": "Choreo Integrator"
      },
      {
        "command": "wso2.integrator.setupBallerinaVisually",
        "title": "Setup Ballerina"
      },
      {
        "command": "BI.project-explorer.add-workflow",
        "title": "Add Workflow",
        "icon": "$(add)",
        "category": "Choreo Integrator"
      },
      {
        "command": "BI.project-explorer.add-workflow-activity",
        "title": "Add Workflow Activity",
        "icon": "$(add)",
        "category": "Choreo Integrator"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "wso2.integrator.cloud.auth.switchRegion",
          "when": "wso2.integrator.cloud.multiRegion"
        },
        {
          "command": "ballerina.showVisualizer",
          "when": "false"
        },
        {
          "command": "ballerina.force.update.artifacts",
          "when": "false"
        },
        {
          "command": "BI.project-explorer.add",
          "when": "false"
        },
        {
          "command": "BI.project-explorer.convert",
          "when": "false"
        },
        {
          "command": "BI.project-explorer.open-project",
          "when": "false"
        },
        {
          "command": "BI.project-explorer.add-to-project",
          "when": "false"
        },
        {
          "command": "BI.project-explorer.overview",
          "when": "false"
        },
        {
          "command": "BI.project-explorer.add-connection",
          "when": "false"
        },
        {
          "command": "BI.project-explorer.add-agent",
          "when": "false"
        },
        {
          "command": "BI.project-explorer.add-agent-definition",
          "when": "false"
        },
        {
          "command": "BI.project-explorer.add-agent-tool",
          "when": "false"
        },
        {
          "command": "BI.project-explorer.add-model-provider",
          "when": "false"
        },
        {
          "command": "BI.project-explorer.delete",
          "when": "false"
        },
        {
          "command": "BI.project-explorer.add-entry-point",
          "when": "false"
        },
        {
          "command": "BI.project-explorer.add-type",
          "when": "false"
        },
        {
          "command": "BI.project-explorer.view-type-diagram",
          "when": "false"
        },
        {
          "command": "BI.project-explorer.add-function",
          "when": "false"
        },
        {
          "command": "BI.project-explorer.add-configuration",
          "when": "false"
        },
        {
          "command": "BI.project-explorer.view-configuration",
          "when": "false"
        },
        {
          "command": "BI.project-explorer.add-data-mapper",
          "when": "false"
        },
        {
          "command": "BI.project-explorer.add-natural-function",
          "when": "false"
        },
        {
          "command": "BI.project-explorer.add-custom-connector",
          "when": "false"
        },
        {
          "command": "wso2.integrator.setupBallerinaVisually",
          "when": "false"
        },
        {
          "command": "BI.project-explorer.add-workflow",
          "when": "false"
        },
        {
          "command": "BI.project-explorer.add-workflow-activity",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "ballerina.showVisualizer",
          "when": "(view == wso2-integrator.explorer || view == wso2-agent-builder.explorer) && viewItem == bi-project",
          "group": "inline"
        },
        {
          "command": "ballerina.force.update.artifacts",
          "when": "(view == wso2-integrator.explorer || view == wso2-agent-builder.explorer) && viewItem == bi-project",
          "group": "inline"
        },
        {
          "command": "BI.project-explorer.convert",
          "when": "(view == wso2-integrator.explorer || view == wso2-agent-builder.explorer) && viewItem == bi-project && BI.isBallerinaWorkspace != true && BI.enclosingProjectStatus != 'member' && BI.enclosingProjectStatus != 'orphaned'",
          "group": "navigation"
        },
        {
          "command": "BI.project-explorer.open-project",
          "when": "(view == wso2-integrator.explorer || view == wso2-agent-builder.explorer) && viewItem == bi-project && BI.isBallerinaWorkspace != true && BI.enclosingProjectStatus == 'member'",
          "group": "navigation"
        },
        {
          "command": "BI.project-explorer.add-to-project",
          "when": "(view == wso2-integrator.explorer || view == wso2-agent-builder.explorer) && viewItem == bi-project && BI.isBallerinaWorkspace != true && BI.enclosingProjectStatus == 'orphaned'",
          "group": "navigation"
        },
        {
          "command": "BI.project-explorer.add-connection",
          "when": "(view == wso2-integrator.explorer || view == wso2-agent-builder.explorer) && viewItem == connections",
          "group": "inline"
        },
        {
          "command": "BI.project-explorer.add-agent",
          "when": "(view == wso2-integrator.explorer || view == wso2-agent-builder.explorer) && viewItem == agents",
          "group": "inline"
        },
        {
          "command": "BI.project-explorer.add-agent-definition",
          "when": "(view == wso2-integrator.explorer || view == wso2-agent-builder.explorer) && viewItem == agentDefinitions",
          "group": "inline"
        },
        {
          "command": "BI.project-explorer.add-agent-tool",
          "when": "view == wso2-agent-builder.explorer && viewItem == agentTools",
          "group": "inline"
        },
        {
          "command": "BI.project-explorer.add-model-provider",
          "when": "view == wso2-agent-builder.explorer && viewItem == modelProviders",
          "group": "inline"
        },
        {
          "command": "BI.project-explorer.delete",
          "when": "(view == wso2-integrator.explorer || view == wso2-agent-builder.explorer) && (viewItem == CONNECTION || viewItem == SERVICE || viewItem == FUNCTION || viewItem == AUTOMATION || viewItem == TYPE || viewItem == CONFIGURABLE || viewItem == DATA_MAPPER || viewItem == NP_FUNCTION || viewItem == localConnector || viewItem == WORKFLOW || viewItem == ACTIVITY || viewItem == AGENT || viewItem == AGENT_DEFINITION || viewItem == AGENT_TOOL)",
          "group": "inline"
        },
        {
          "command": "BI.project-explorer.add-entry-point",
          "when": "view == wso2-integrator.explorer && viewItem == entryPoint",
          "group": "inline"
        },
        {
          "command": "BI.project-explorer.add-type",
          "when": "(view == wso2-integrator.explorer || view == wso2-agent-builder.explorer) && viewItem == types",
          "group": "inline"
        },
        {
          "command": "BI.project-explorer.view-type-diagram",
          "when": "(view == wso2-integrator.explorer || view == wso2-agent-builder.explorer) && viewItem == types",
          "group": "inline"
        },
        {
          "command": "BI.project-explorer.add-function",
          "when": "(view == wso2-integrator.explorer || view == wso2-agent-builder.explorer) && viewItem == functions",
          "group": "inline"
        },
        {
          "command": "BI.project-explorer.add-configuration",
          "when": "(view == wso2-integrator.explorer || view == wso2-agent-builder.explorer) && viewItem == configurations",
          "group": "inline"
        },
        {
          "command": "BI.project-explorer.view-configuration",
          "when": "(view == wso2-integrator.explorer || view == wso2-agent-builder.explorer) && viewItem == configurations",
          "group": "inline"
        },
        {
          "command": "BI.project-explorer.add-data-mapper",
          "when": "view == wso2-integrator.explorer && viewItem == dataMappers",
          "group": "inline"
        },
        {
          "command": "BI.project-explorer.add-natural-function",
          "when": "(view == wso2-integrator.explorer || view == wso2-agent-builder.explorer) && viewItem == naturalFunctions",
          "group": "inline"
        },
        {
          "command": "BI.project-explorer.add-custom-connector",
          "when": "(view == wso2-integrator.explorer || view == wso2-agent-builder.explorer) && viewItem == localConnectors",
          "group": "inline"
        },
        {
          "command": "BI.project-explorer.add-workflow",
          "when": "view == wso2-integrator.explorer && viewItem == workflows",
          "group": "inline"
        },
        {
          "command": "BI.project-explorer.add-workflow-activity",
          "when": "view == wso2-integrator.explorer && viewItem == workflowActivities",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "wso2-integrator.explorer.refresh",
          "when": "(view == wso2-integrator.explorer || view == wso2-agent-builder.explorer)",
          "group": "navigation@2"
        },
        {
          "command": "BI.project-explorer.convert",
          "when": "(view == wso2-integrator.explorer || view == wso2-agent-builder.explorer) && BI.project == true && BI.isBallerinaWorkspace != true && BI.enclosingProjectStatus != 'member' && BI.enclosingProjectStatus != 'orphaned'",
          "group": "navigation"
        },
        {
          "command": "BI.project-explorer.open-project",
          "when": "(view == wso2-integrator.explorer || view == wso2-agent-builder.explorer) && BI.project == true && BI.isBallerinaWorkspace != true && BI.enclosingProjectStatus == 'member'",
          "group": "navigation"
        },
        {
          "command": "BI.project-explorer.add-to-project",
          "when": "(view == wso2-integrator.explorer || view == wso2-agent-builder.explorer) && BI.project == true && BI.isBallerinaWorkspace != true && BI.enclosingProjectStatus == 'orphaned'",
          "group": "navigation"
        },
        {
          "command": "BI.project-explorer.add",
          "when": "(view == wso2-integrator.explorer || view == wso2-agent-builder.explorer) && BI.isBallerinaWorkspace == true",
          "group": "navigation"
        },
        {
          "command": "BI.project-explorer.overview",
          "when": "(view == wso2-integrator.explorer || view == wso2-agent-builder.explorer) && BI.project == true",
          "group": "navigation"
        }
      ]
    },
    "icons": {}
  },
